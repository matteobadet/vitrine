---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import portrait from '../assets/matteo.jpg';

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const projects = [
  {
    name: 'RandoHost',
    description:
      'Gestion de médias (photos/vidéos) géolocalisés pour randonneurs : carte interactive, albums partagés et rôles par groupe.',
    url: 'https://randohost.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'PostgreSQL'],
  },
  {
    name: 'CycloTrack',
    description:
      'Suivi d’activités vélo avec coaching par IA — application mobile, web et API dédiée.',
    url: 'https://cyclotrack.mbadet.fr',
    status: 'live' as const,
    tags: ['React Native', 'React', 'ASP.NET Core'],
  },
  {
    name: 'SkillForge',
    description:
      'Plateforme auto-hébergée pour partager des Skills, MCP et Agents Claude au sein d’un cercle d’amis.',
    url: 'https://skillforge.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'Kubernetes'],
  },
  {
    name: 'ScrumMaster',
    description:
      'Outil de facilitation agile (mêlées, rétrospectives) intégré à Microsoft Teams et connecté à Azure DevOps Boards.',
    url: 'https://scrummaster.mbadet.fr',
    status: 'live' as const,
    tags: ['C#', 'Microsoft Teams', 'Azure DevOps'],
  },
  {
    name: 'ApexGrid',
    description:
      'Simulateur de course top-down où les voitures sont pilotées uniquement par des scripts externes via un protocole TCP/WebSocket documenté.',
    url: 'https://apexgrid.mbadet.fr',
    status: 'live' as const,
    tags: ['TypeScript', 'Node.js', 'WebSocket'],
  },
  {
    name: 'Arya Hub',
    description:
      'Tableau de bord d’équipe pour piloter des agents Claude Code sur des projets réels — sessions en direct, approbations humaines, intégration Azure DevOps (work items, PR, pipelines).',
    url: 'https://aryahub.mbadet.fr',
    status: 'live' as const,
    tags: ['Angular', 'Fastify', 'PostgreSQL', 'Claude Agent SDK'],
  },
];
---

<Layout
  title="Accueil"
  description="Portfolio de Matteo Badet — projets personnels : RandoHost, CycloTrack, SkillForge, ScrumMaster, ApexGrid, Arya Hub."
>
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <h1>
          Bonjour, je suis <span class="gradient-text">Matteo Badet</span>
        </h1>
        <p class="hero-subtitle">
          Développeur fullstack — C# / .NET côté API, TypeScript / Angular
          (Nx) côté front. <!-- TODO : compléter avec une accroche plus personnelle si besoin -->
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Me contacter</a>
          <a href="/a-propos" class="btn btn-secondary">À propos de moi</a>
        </div>
      </div>
      <Image
        src={portrait}
        alt="Portrait de Matteo Badet"
        width={280}
        height={280}
        class="hero-portrait"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Mes projets</h2>
      <div class="project-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
  }

  .hero-portrait {
    width: 220px;
    height: 220px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-glow);
    justify-self: end;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    max-width: 20ch;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    max-width: 55ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 720px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-portrait {
      justify-self: center;
      order: -1;
    }

    .hero-actions {
      justify-content: center;
    }
  }
</style>
