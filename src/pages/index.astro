---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NatureScene from '../components/NatureScene.astro';

const accents = ['terracotta', 'sky', 'amber', 'primary'] as const;

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const projects = [
  {
    name: 'RandoHost',
    description:
      'Gestion de médias (photos/vidéos) géolocalisés pour randonneurs : carte interactive, albums partagés et rôles par groupe.',
    url: 'https://randohost.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'PostgreSQL'],
  },
  {
    name: 'CycloTrack',
    description:
      'Suivi d’activités vélo avec coaching par IA — application mobile, web et API dédiée.',
    url: 'https://cyclotrack.mbadet.fr',
    status: 'live' as const,
    tags: ['React Native', 'React', 'ASP.NET Core'],
  },
  {
    name: 'SkillForge',
    description:
      'Plateforme auto-hébergée pour partager des Skills, MCP et Agents Claude au sein d’un cercle d’amis.',
    url: 'https://skillforge.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'Kubernetes'],
  },
  {
    name: 'ScrumMaster',
    description:
      'Outil de facilitation agile (mêlées, rétrospectives) intégré à Microsoft Teams et connecté à Azure DevOps Boards.',
    url: 'https://scrummaster.mbadet.fr',
    status: 'live' as const,
    tags: ['C#', 'Microsoft Teams', 'Azure DevOps'],
  },
  {
    name: 'ApexGrid',
    description:
      'Simulateur de course top-down où les voitures sont pilotées uniquement par des scripts externes via un protocole TCP/WebSocket documenté.',
    url: 'https://apexgrid.mbadet.fr',
    status: 'live' as const,
    tags: ['TypeScript', 'Node.js', 'WebSocket'],
  },
  {
    name: 'Arya Hub',
    description:
      'Tableau de bord d’équipe pour piloter des agents Claude Code sur des projets réels — sessions en direct, approbations humaines, intégration Azure DevOps (work items, PR, pipelines).',
    url: 'https://aryahub.mbadet.fr',
    status: 'live' as const,
    tags: ['Angular', 'Fastify', 'PostgreSQL', 'Claude Agent SDK'],
  },
];
---

<Layout
  title="Accueil"
  description="Portfolio de Matteo Badet — projets personnels : RandoHost, CycloTrack, SkillForge, ScrumMaster, ApexGrid, Arya Hub."
>
  <NatureScene>
    <h1>
      Salut, je suis <span class="highlight">Matteo Badet</span>
      <svg class="wave-icon" viewBox="0 0 48 48" width="34" height="34" aria-hidden="true">
        <defs>
          <linearGradient id="waveSkin" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#f2cda3" />
            <stop offset="100%" stop-color="#dba877" />
          </linearGradient>
        </defs>
        <path
          d="M20 44 Q14 44 12 38 L10 24 Q9 20 12 19 Q15 18 16 22 L17 28 L17 12 Q17 8 20 8 Q23 8 23 12 L23 24 L24 9 Q24 5 27 5 Q30 5 30 9 L30 24 L31 11 Q31 7 34 7 Q37 7 37 11 L37 26 Q40 25 41 28 Q42 31 40 34 L36 42 Q33 44 28 44 Z"
          fill="url(#waveSkin)"
          stroke="var(--color-ink)"
          stroke-width="1"
        />
      </svg>
    </h1>
    <p class="hero-subtitle">
      Développeur fullstack — C# / .NET côté API, TypeScript / Angular
      (Nx) côté front.
    </p>
    <div class="hero-actions">
      <a href="/contact" class="btn btn-primary">Me contacter</a>
      <a href="/a-propos" class="btn btn-secondary">À propos de moi</a>
    </div>
  </NatureScene>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Portfolio</p>
      <h2 class="reveal">Mes projets</h2>
      <div class="project-grid">
        {projects.map((project, i) => (
          <ProjectCard {...project} accent={accents[i % accents.length]} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  h1 {
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    max-width: 18ch;
  }

  .wave-icon {
    display: inline-block;
    vertical-align: -0.2em;
    transform-origin: 50% 90%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wave-icon {
      animation: wave 2.2s ease-in-out infinite;
    }
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10% { transform: rotate(16deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(16deg); }
    40% { transform: rotate(-4deg); }
  }

  .highlight::after {
    background: var(--color-amber);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    max-width: 55ch;
    margin-top: 0.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.75rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .project-grid > :global(.project-card:nth-child(1)) { transition-delay: 0s; }
  .project-grid > :global(.project-card:nth-child(2)) { transition-delay: 0.06s; }
  .project-grid > :global(.project-card:nth-child(3)) { transition-delay: 0.12s; }
  .project-grid > :global(.project-card:nth-child(4)) { transition-delay: 0.18s; }
  .project-grid > :global(.project-card:nth-child(5)) { transition-delay: 0.24s; }
  .project-grid > :global(.project-card:nth-child(6)) { transition-delay: 0.3s; }

  @media (max-width: 720px) {
    .hero-actions {
      justify-content: center;
    }
  }
</style>
