---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const projects = [
  {
    name: 'RandoHost',
    description:
      'Gestion de médias (photos/vidéos) géolocalisés pour randonneurs : carte interactive, albums partagés et rôles par groupe.',
    url: 'https://randohost.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'PostgreSQL'],
  },
  {
    name: 'CycloTrack',
    description:
      'Suivi d’activités vélo avec coaching par IA — application mobile, web et API dédiée.',
    url: 'https://cyclotrack.mbadet.fr',
    status: 'live' as const,
    tags: ['React Native', 'React', 'ASP.NET Core'],
  },
  {
    name: 'SkillForge',
    description:
      'Plateforme auto-hébergée pour partager des Skills, MCP et Agents Claude au sein d’un cercle d’amis.',
    url: 'https://skillforge.mbadet.fr',
    status: 'live' as const,
    tags: ['React', 'ASP.NET Core', 'Kubernetes'],
  },
  {
    name: 'ScrumMaster',
    description:
      'Outil de facilitation agile (mêlées, rétrospectives) intégré à Microsoft Teams et connecté à Azure DevOps Boards.',
    url: 'https://scrummaster.mbadet.fr',
    status: 'live' as const,
    tags: ['C#', 'Microsoft Teams', 'Azure DevOps'],
  },
  {
    name: 'ApexGrid',
    description:
      'Simulateur de course top-down où les voitures sont pilotées uniquement par des scripts externes via un protocole TCP/WebSocket documenté.',
    url: 'https://apexgrid.mbadet.fr',
    status: 'live' as const,
    tags: ['TypeScript', 'Node.js', 'WebSocket'],
  },
  {
    name: 'Arya Hub',
    description:
      'Tableau de bord d’équipe pour piloter des agents Claude Code sur des projets réels — sessions en direct, approbations humaines, intégration Azure DevOps (work items, PR, pipelines).',
    url: 'https://aryahub.mbadet.fr',
    status: 'live' as const,
    tags: ['Angular', 'Fastify', 'PostgreSQL', 'Claude Agent SDK'],
  },
];
---

<Layout
  title="Accueil"
  description="Portfolio de Matteo Badet — projets personnels : RandoHost, CycloTrack, SkillForge, ScrumMaster, ApexGrid, Arya Hub."
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow reveal">Développeur fullstack · Dijon, France</p>
      <h1 class="reveal">Matteo Badet</h1>
      <p class="hero-role reveal" style="transition-delay: 0.06s">
        C# / .NET côté API — TypeScript / Angular (Nx) côté front.
      </p>
      <div class="hero-actions reveal" style="transition-delay: 0.12s">
        <a href="/contact" class="btn btn-primary">Me contacter</a>
        <a href="/a-propos" class="btn btn-secondary">À propos de moi</a>
      </div>
    </div>
  </section>

  <section class="section projects">
    <div class="container">
      <p class="eyebrow reveal">Portfolio</p>
      <h2 class="reveal">Mes projets</h2>
      <div class="project-list">
        {projects.map((project, i) => <ProjectCard {...project} index={i + 1} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 6rem;
    padding-bottom: 3rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 7vw, 4.75rem);
    max-width: 16ch;
  }

  .hero-role {
    font-size: 1.15rem;
    max-width: 50ch;
    margin-top: 0.75rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .projects {
    padding-top: 2rem;
  }

  .project-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .project-list > :global(.project-row:nth-child(1)) { transition-delay: 0s; }
  .project-list > :global(.project-row:nth-child(2)) { transition-delay: 0.06s; }
  .project-list > :global(.project-row:nth-child(3)) { transition-delay: 0.12s; }
  .project-list > :global(.project-row:nth-child(4)) { transition-delay: 0.18s; }
  .project-list > :global(.project-row:nth-child(5)) { transition-delay: 0.24s; }
  .project-list > :global(.project-row:nth-child(6)) { transition-delay: 0.3s; }
</style>
