---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import NatureScene from '../components/NatureScene.astro';
import portrait from '../assets/matteo.jpg';

const accents = ['terracotta', 'sky', 'amber', 'primary'];

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const skills = [
  'C# / .NET (API)',
  'ASP.NET Core',
  'TypeScript',
  'Angular',
  'Nx (monorepo)',
  'SQL Server / PostgreSQL',
  'Docker / Kubernetes',
  'Méthodes agiles',
];

const timeline = [
  {
    period: 'avr. 2024 — aujourd’hui',
    title: 'Développeur back-end (alternance puis CDI)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'sept. 2023 — avr. 2024',
    title: 'Développeur Delphi (alternance)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'juil. 2023 — sept. 2023',
    title: 'Développeur Delphi (CDD)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'mai 2023 — juil. 2023',
    title: 'Stagiaire développement web',
    place: 'AIST 21, Dijon',
  },
  {
    period: '2021 — 2024',
    title: 'BUT Informatique',
    place: 'IUT Dijon-Auxerre-Nevers',
  },
  {
    period: '2018 — 2021',
    title: 'Baccalauréat, spécialité NSI/SI',
    place: 'Lycée Gustave Eiffel, Dijon',
  },
];
---

<Layout
  title="À propos"
  description="Parcours, compétences et bio de Matteo Badet."
>
  <NatureScene>
    <Image
      src={portrait}
      alt="Portrait de Matteo Badet"
      width={72}
      height={72}
      class="portrait"
    />
    <h1>À propos</h1>
    <p class="bio">
      Développeur back-end chez YMAG, à Dijon, après un BUT Informatique à
      l'IUT Dijon-Auxerre-Nevers. Passionné d'informatique et de nouvelles
      technologies — réalité augmentée/virtuelle, intelligence
      artificielle — je continue de coder en dehors du travail sur mes
      projets personnels. Et pour décrocher des écrans, je vais chercher
      la liberté en pleine nature : randonnée, escalade — qui m'a même
      aidé à apprivoiser mon vertige — et quelques sports de raquette que
      je pratique depuis tout petit.
    </p>
  </NatureScene>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Stack</p>
      <h2 class="reveal">Compétences</h2>
      <ul class="skills-list">
        {skills.map((skill, i) => (
          <li
            class="reveal"
            style={`transition-delay: ${Math.min(i, 6) * 0.06}s; --chip-accent: var(--color-${accents[i % accents.length]})`}
          >
            {skill}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Depuis 2021</p>
      <h2 class="reveal">Parcours</h2>
      <ol class="timeline">
        {
          timeline.map((entry, i) => (
            <li
              class="reveal"
              style={`transition-delay: ${Math.min(i, 6) * 0.08}s; --dot-accent: var(--color-${accents[i % accents.length]})`}
            >
              <span class="timeline-dot"></span>
              <span class="timeline-period">{entry.period}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .portrait {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 2px solid var(--color-ink);
    margin-bottom: 1rem;
  }

  .bio {
    font-size: 1.05rem;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .skills-list li {
    padding: 0.5em 1em;
    border-radius: var(--radius-md);
    border: 2px solid var(--chip-accent, var(--color-border));
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 152px;
    width: 2px;
    background: linear-gradient(var(--color-border), var(--color-border)) padding-box;
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
  }

  .timeline-dot {
    position: absolute;
    left: 148px;
    top: 5px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot-accent, var(--color-primary));
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .timeline-period {
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--color-muted);
  }

  .timeline h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2em;
  }

  .timeline p {
    margin: 0;
  }

  @media (max-width: 560px) {
    .timeline::before {
      left: 4px;
    }

    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-left: 1.5rem;
    }

    .timeline-dot {
      left: 0;
    }
  }
</style>
