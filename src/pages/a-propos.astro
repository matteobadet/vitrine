---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/matteo.jpg';

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const skills = [
  'C# / .NET (API)',
  'ASP.NET Core',
  'TypeScript',
  'Angular',
  'Nx (monorepo)',
  'SQL Server / PostgreSQL',
  'Docker / Kubernetes',
  'Méthodes agiles',
];

const timeline = [
  {
    period: 'avr. 2024 — aujourd’hui',
    title: 'Développeur back-end (alternance puis CDI)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'sept. 2023 — avr. 2024',
    title: 'Développeur Delphi (alternance)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'juil. 2023 — sept. 2023',
    title: 'Développeur Delphi (CDD)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'mai 2023 — juil. 2023',
    title: 'Stagiaire développement web',
    place: 'AIST 21, Dijon',
  },
  {
    period: '2021 — 2024',
    title: 'BUT Informatique',
    place: 'IUT Dijon-Auxerre-Nevers',
  },
  {
    period: '2018 — 2021',
    title: 'Baccalauréat, spécialité NSI/SI',
    place: 'Lycée Gustave Eiffel, Dijon',
  },
];
---

<Layout
  title="À propos"
  description="Parcours, compétences et bio de Matteo Badet."
>
  <section class="section">
    <div class="container intro-grid">
      <Image
        src={portrait}
        alt="Portrait de Matteo Badet"
        width={320}
        height={320}
        class="portrait"
      />
      <div>
        <h1>À propos</h1>
        <p class="bio">
          Développeur back-end chez YMAG, à Dijon, après un BUT Informatique à
          l'IUT Dijon-Auxerre-Nevers. Passionné d'informatique et de nouvelles
          technologies — réalité augmentée/virtuelle, intelligence
          artificielle — je continue de coder en dehors du travail : projets
          personnels, jeux vidéo, et un peu de badminton pour décrocher.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Compétences</h2>
      <ul class="skills-list">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Parcours</h2>
      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li>
              <span class="timeline-period">{entry.period}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .portrait {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-glow);
  }

  .bio {
    font-size: 1.1rem;
    max-width: 65ch;
  }

  @media (max-width: 560px) {
    .intro-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .skills-list li {
    padding: 0.5em 1.1em;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline-period {
    font-weight: 600;
    color: var(--color-accent-3);
    font-size: 0.9rem;
  }

  .timeline h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2em;
  }

  .timeline p {
    margin: 0;
  }

  @media (max-width: 560px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
