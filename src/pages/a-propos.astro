---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/matteo.jpg';

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const skills = [
  'C# / .NET (API)',
  'TypeScript',
  'Angular',
  'Nx (monorepo)',
  // TODO : ajouter d'autres compétences si besoin (bases de données, outils, etc.)
];

const timeline = [
  { period: 'TODO — TODO', title: 'TODO : intitulé du poste / formation', place: 'TODO : entreprise / école' },
  { period: 'TODO — TODO', title: 'TODO : intitulé du poste / formation', place: 'TODO : entreprise / école' },
];
---

<Layout
  title="À propos"
  description="Parcours, compétences et bio de Matteo Badet."
>
  <section class="section">
    <div class="container intro-grid">
      <Image
        src={portrait}
        alt="Portrait de Matteo Badet"
        width={320}
        height={320}
        class="portrait"
      />
      <div>
        <h1>À propos</h1>
        <p class="bio">
          TODO : bio de présentation (2-4 phrases sur votre parcours, ce qui vous
          motive, le type de projets que vous aimez construire).
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Compétences</h2>
      <ul class="skills-list">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Parcours</h2>
      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li>
              <span class="timeline-period">{entry.period}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .portrait {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-glow);
  }

  .bio {
    font-size: 1.1rem;
    max-width: 65ch;
  }

  @media (max-width: 560px) {
    .intro-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .skills-list li {
    padding: 0.5em 1.1em;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-weight: 500;
    font-size: 0.9rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline-period {
    font-weight: 600;
    color: var(--color-accent-3);
    font-size: 0.9rem;
  }

  .timeline h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2em;
  }

  .timeline p {
    margin: 0;
  }

  @media (max-width: 560px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
