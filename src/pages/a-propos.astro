---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/matteo.jpg';

// Contenu codé en dur — à mettre à jour ici puis redéployer.
const skills = [
  'C# / .NET (API)',
  'ASP.NET Core',
  'TypeScript',
  'Angular',
  'Nx (monorepo)',
  'SQL Server / PostgreSQL',
  'Docker / Kubernetes',
  'Méthodes agiles',
];

const timeline = [
  {
    period: 'avr. 2024 — aujourd’hui',
    title: 'Développeur back-end (alternance puis CDI)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'sept. 2023 — avr. 2024',
    title: 'Développeur Delphi (alternance)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'juil. 2023 — sept. 2023',
    title: 'Développeur Delphi (CDD)',
    place: 'YMAG, Dijon',
  },
  {
    period: 'mai 2023 — juil. 2023',
    title: 'Stagiaire développement web',
    place: 'AIST 21, Dijon',
  },
  {
    period: '2021 — 2024',
    title: 'BUT Informatique',
    place: 'IUT Dijon-Auxerre-Nevers',
  },
  {
    period: '2018 — 2021',
    title: 'Baccalauréat, spécialité NSI/SI',
    place: 'Lycée Gustave Eiffel, Dijon',
  },
];
---

<Layout
  title="À propos"
  description="Parcours, compétences et bio de Matteo Badet."
>
  <section class="section">
    <div class="container intro-grid">
      <div class="reveal">
        <Image
          src={portrait}
          alt="Portrait de Matteo Badet"
          width={320}
          height={320}
          class="portrait"
        />
      </div>
      <div class="reveal" style="transition-delay: 0.1s">
        <h1>À propos</h1>
        <p class="bio">
          Développeur back-end chez YMAG, à Dijon, après un BUT Informatique à
          l'IUT Dijon-Auxerre-Nevers. Passionné d'informatique et de nouvelles
          technologies — réalité augmentée/virtuelle, intelligence
          artificielle — je continue de coder en dehors du travail : projets
          personnels, jeux vidéo, et un peu de badminton pour décrocher.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Stack</p>
      <h2 class="reveal">Compétences</h2>
      <ul class="skills-list">
        {skills.map((skill, i) => <li class="reveal" style={`transition-delay: ${Math.min(i, 6) * 0.06}s`}>{skill}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Depuis 2021</p>
      <h2 class="reveal">Parcours</h2>
      <ol class="timeline">
        {
          timeline.map((entry, i) => (
            <li class="reveal" style={`transition-delay: ${Math.min(i, 6) * 0.08}s`}>
              <span class="timeline-dot"></span>
              <span class="timeline-period">{entry.period}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.place}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .portrait {
    width: 160px;
    height: 160px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-glow);
  }

  .bio {
    font-size: 1.1rem;
    max-width: 65ch;
  }

  @media (max-width: 560px) {
    .intro-grid {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }

  .skills-list li {
    padding: 0.5em 1em;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .timeline {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 152px;
    width: 2px;
    background: linear-gradient(var(--color-border), var(--color-border)) padding-box;
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
  }

  .timeline-dot {
    position: absolute;
    left: 148px;
    top: 5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .timeline h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2em;
  }

  .timeline p {
    margin: 0;
  }

  @media (max-width: 560px) {
    .timeline::before {
      left: 4px;
    }

    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-left: 1.5rem;
    }

    .timeline-dot {
      left: 0;
    }
  }
</style>
