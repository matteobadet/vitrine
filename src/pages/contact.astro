---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import CyclingScene from '../components/CyclingScene.astro';
---

<Layout
  title="Contact"
  description="Contactez Matteo Badet pour un projet, une question ou une proposition."
>
  <CyclingScene>
    <h1>Contact</h1>
    <p class="intro">
      Une question, un projet en tête ? Écrivez-moi via le formulaire
      ci-dessous.
    </p>
    <ContactForm />
  </CyclingScene>
</Layout>

<style>
  .intro {
    max-width: 50ch;
    margin-bottom: 1.5rem;
  }
</style>
