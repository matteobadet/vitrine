---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import LowPolyScene from '../components/LowPolyScene.astro';
---

<Layout
  title="Contact"
  description="Contactez Matteo Badet pour un projet, une question ou une proposition."
>
  <LowPolyScene variant="bivouac" sparkTrigger="contact:serve">
    <h1>Contact</h1>
    <p class="intro">
      Un projet, une idée, une question ou juste envie de discuter ?
      Laissez-moi un message, je réponds généralement sous quelques jours.
    </p>
    <ContactForm />
  </LowPolyScene>
</Layout>

<style>
  .intro {
    max-width: 50ch;
    margin-bottom: 1.5rem;
  }
</style>
