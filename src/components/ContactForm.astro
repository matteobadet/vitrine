<div class="contact-layout">
  <form id="contact-form" class="contact-form" novalidate>
    <div class="field">
      <label for="name">Nom</label>
      <input type="text" id="name" name="name" required maxlength="100" autocomplete="name" />
    </div>

    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required maxlength="200" autocomplete="email" />
    </div>

    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" required maxlength="4000" rows="6"></textarea>
    </div>

    <!-- Honeypot anti-spam : champ caché, doit rester vide -->
    <div class="field field--honeypot" aria-hidden="true">
      <label for="company">Entreprise</label>
      <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="btn btn-primary">Envoyer le message</button>

    <p id="form-status" role="status" aria-live="polite"></p>
  </form>

  <svg
    id="badminton-player"
    class="badminton-player"
    viewBox="0 0 240 260"
    aria-hidden="true"
    focusable="false"
  >
    <ellipse cx="122" cy="248" rx="52" ry="8" fill="var(--color-ink)" opacity="0.08" />

    <g id="body-group">
      <!-- legs -->
      <rect x="99" y="188" width="14" height="52" rx="6" fill="#f4efe4" />
      <rect x="127" y="188" width="14" height="52" rx="6" fill="#f4efe4" />
      <rect x="97" y="232" width="18" height="10" rx="4" fill="var(--color-ink)" />
      <rect x="125" y="232" width="18" height="10" rx="4" fill="var(--color-ink)" />

      <!-- shorts -->
      <rect x="96" y="158" width="52" height="36" rx="10" fill="var(--color-terracotta)" />

      <!-- static arm -->
      <line x1="98" y1="122" x2="80" y2="152" stroke="#e7b892" stroke-width="10" stroke-linecap="round" />

      <!-- torso -->
      <rect x="93" y="108" width="56" height="58" rx="16" fill="var(--color-sky)" />

      <!-- neck + head -->
      <rect x="114" y="98" width="14" height="14" fill="#e7b892" />
      <circle cx="121" cy="84" r="20" fill="#e7b892" />
      <path d="M101 82 a20 20 0 0 1 40 -3 q-8 -6 -20 -6 t-20 6 q0 1.5 0 3z" fill="var(--color-ink)" />
    </g>

    <g id="racket-arm">
      <line x1="147" y1="116" x2="172" y2="98" stroke="#e7b892" stroke-width="10" stroke-linecap="round" />
      <line x1="172" y1="98" x2="190" y2="68" stroke="#e7b892" stroke-width="9" stroke-linecap="round" />
      <circle cx="190" cy="68" r="6" fill="#e7b892" />
      <line x1="190" y1="68" x2="204" y2="48" stroke="var(--color-ink)" stroke-width="4" stroke-linecap="round" />
      <ellipse cx="213" cy="36" rx="15" ry="21" fill="none" stroke="var(--color-ink)" stroke-width="3" transform="rotate(-35 213 36)" />
      <ellipse cx="213" cy="36" rx="10" ry="16" fill="var(--color-amber)" opacity="0.35" transform="rotate(-35 213 36)" />
    </g>

    <g id="shuttlecock">
      <circle cx="205" cy="24" r="4" fill="var(--color-terracotta)" />
      <path d="M205 24 L198 8 L212 8 Z" fill="#f4efe4" stroke="var(--color-ink)" stroke-width="1.5" />
    </g>
  </svg>
</div>

<style>
  .contact-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 480px;
    flex: 1 1 320px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field--honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.75em 1em;
    border-radius: var(--radius-md);
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(47, 107, 79, 0.15);
  }

  button {
    align-self: flex-start;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  #form-status {
    margin: 0;
    font-size: 0.9rem;
  }

  #form-status[data-state='success'] {
    color: var(--color-primary);
  }

  #form-status[data-state='error'] {
    color: var(--color-terracotta);
  }

  .badminton-player {
    width: 200px;
    height: auto;
    flex: 0 0 200px;
    margin-top: 1rem;
  }

  #racket-arm {
    transform-origin: 147px 116px;
  }

  #body-group {
    transform-origin: 122px 200px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .badminton-player.is-serving #racket-arm {
      animation: racket-swing 0.9s ease-in-out;
    }

    .badminton-player.is-serving #body-group {
      animation: body-lean 0.9s ease-in-out;
    }

    .badminton-player.is-serving #shuttlecock {
      animation: shuttle-fly 0.9s ease-in-out;
    }
  }

  @keyframes racket-swing {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-35deg); }
    45% { transform: rotate(55deg); }
    70% { transform: rotate(20deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes body-lean {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    45% { transform: translateX(-4px) rotate(-3deg); }
  }

  @keyframes shuttle-fly {
    0%, 40% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    45% { opacity: 1; }
    100% { transform: translate(90px, -70px) rotate(180deg); opacity: 0; }
  }

  @media (max-width: 640px) {
    .badminton-player {
      width: 140px;
      flex-basis: 140px;
      margin: 0 auto;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLParagraphElement;
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const player = document.getElementById('badminton-player') as SVGSVGElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    statusEl.dataset.state = '';
    statusEl.textContent = '';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi en cours…';

    player.classList.remove('is-serving');
    void player.getBoundingClientRect();
    player.classList.add('is-serving');

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? 'Une erreur est survenue.');
      }

      statusEl.dataset.state = 'success';
      statusEl.textContent = 'Message envoyé, merci ! Je vous répondrai rapidement.';
      form.reset();
    } catch (err) {
      statusEl.dataset.state = 'error';
      statusEl.textContent =
        err instanceof Error ? err.message : "Échec de l'envoi, réessayez plus tard.";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer le message';
    }
  });
</script>
