---
interface Props {
  name: string;
  description: string;
  url: string;
  status: 'live' | 'dev';
  tags: string[];
  accent: 'coral' | 'emerald' | 'amber' | 'primary';
}

const { name, description, url, status, tags, accent } = Astro.props;
const statusLabel = status === 'live' ? 'En ligne' : 'En développement';
const initial = name.charAt(0);
---

<a href={url} class:list={['project-card', 'reveal', `accent-${accent}`]} target="_blank" rel="noopener noreferrer">
  <div class="card-top">
    <span class="chip" aria-hidden="true">{initial}</span>
    <span class:list={['status', { 'status--dev': status === 'dev' }]}>{statusLabel}</span>
  </div>
  <h3>{name}</h3>
  <p>{description}</p>
  <div class="tags">
    {tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <span class="card-cta">Voir le projet <span class="arrow">→</span></span>
</a>

<style>
  .project-card {
    --card-accent: var(--color-primary);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    height: 100%;
  }

  .project-card.accent-coral { --card-accent: var(--color-coral); }
  .project-card.accent-emerald { --card-accent: var(--color-emerald); }
  .project-card.accent-amber { --card-accent: var(--color-amber); }
  .project-card.accent-primary { --card-accent: var(--color-primary); }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-accent);
    box-shadow: var(--shadow-soft);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--card-accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }

  h3 {
    font-size: 1.3rem;
    margin: 0;
  }

  .project-card p {
    margin: 0;
    color: var(--color-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.25em 0.7em;
    border-radius: 999px;
  }

  .card-cta {
    margin-top: 0.25rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--card-accent);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .project-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
