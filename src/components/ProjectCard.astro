---
interface Props {
  name: string;
  description: string;
  url: string;
  status: 'live' | 'dev';
  tags: string[];
  index: number;
}

const { name, description, url, status, tags, index } = Astro.props;
const statusLabel = status === 'live' ? 'En ligne' : 'En développement';
const indexLabel = String(index).padStart(2, '0');
---

<a href={url} class="project-row reveal" target="_blank" rel="noopener noreferrer">
  <span class="project-index mono">{indexLabel}</span>
  <div class="project-main">
    <div class="project-head">
      <h3>{name}</h3>
      <span class:list={['status', { 'status--dev': status === 'dev' }]}>{statusLabel}</span>
    </div>
    <p>{description}</p>
    <div class="project-tags mono">{tags.join(' · ')}</div>
  </div>
  <span class="project-arrow" aria-hidden="true">→</span>
</a>

<style>
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: start;
    gap: 1.5rem;
    padding: 1.75rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.2s ease;
  }

  .project-row:hover {
    background: var(--color-bg-alt);
  }

  .project-row:hover .project-arrow {
    transform: translateX(4px);
    color: var(--color-accent-2);
  }

  .project-row:hover h3 {
    color: var(--color-accent-2);
  }

  .project-index {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-top: 0.2rem;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
  }

  .project-head h3 {
    font-size: 1.35rem;
    margin: 0;
    transition: color 0.2s ease;
  }

  .project-main p {
    margin: 0.6rem 0 0;
    max-width: 60ch;
  }

  .project-tags {
    margin-top: 0.75rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .project-arrow {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
    padding-top: 0.2rem;
  }

  @media (max-width: 640px) {
    .project-row {
      grid-template-columns: 2rem 1fr;
    }

    .project-arrow {
      display: none;
    }
  }
</style>
