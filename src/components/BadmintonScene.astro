<div class="scene-wrap reveal" style="transition-delay: 0.1s">
  <svg
    id="badminton-scene"
    class="badminton-scene"
    viewBox="0 0 480 600"
    preserveAspectRatio="xMidYMax meet"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#eaf4fb" />
        <stop offset="100%" stop-color="#d3e9f7" />
      </linearGradient>
      <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#cfe6dc" />
        <stop offset="100%" stop-color="#b9d9cc" />
      </linearGradient>
      <linearGradient id="skinGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f2cda3" />
        <stop offset="100%" stop-color="#dba877" />
      </linearGradient>
      <linearGradient id="shirtGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#6fb3e6" />
        <stop offset="100%" stop-color="#2f7cc2" />
      </linearGradient>
      <linearGradient id="shortsGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e8965f" />
        <stop offset="100%" stop-color="#c96a3a" />
      </linearGradient>
      <radialGradient id="lightGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fff6d8" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#fff6d8" stop-opacity="0" />
      </radialGradient>
      <pattern id="netMesh" width="10" height="10" patternUnits="userSpaceOnUse">
        <path d="M0 0 L10 10 M10 0 L0 10" stroke="#ffffff" stroke-width="1" opacity="0.55" />
      </pattern>
    </defs>

    <!-- backdrop -->
    <rect x="0" y="0" width="480" height="432" fill="url(#wallGrad)" />
    <rect x="0" y="420" width="480" height="180" fill="url(#floorGrad)" />

    <!-- ceiling lights -->
    <g opacity="0.9">
      <circle cx="90" cy="46" r="36" fill="url(#lightGlow)" />
      <rect x="72" y="34" width="36" height="10" rx="5" fill="#f4efe4" stroke="var(--color-ink)" stroke-width="2" />
      <circle cx="390" cy="40" r="36" fill="url(#lightGlow)" />
      <rect x="372" y="28" width="36" height="10" rx="5" fill="#f4efe4" stroke="var(--color-ink)" stroke-width="2" />
    </g>

    <!-- court lines -->
    <g stroke="#ffffff" stroke-width="3" fill="none" opacity="0.9">
      <rect x="30" y="440" width="420" height="140" rx="2" />
      <line x1="30" y1="500" x2="450" y2="500" />
      <line x1="240" y1="440" x2="240" y2="580" stroke-dasharray="6 6" />
      <rect x="60" y="452" width="360" height="116" rx="2" opacity="0.6" />
    </g>

    <!-- net -->
    <g id="net">
      <line x1="188" y1="330" x2="188" y2="470" stroke="var(--color-ink)" stroke-width="5" stroke-linecap="round" />
      <line x1="188" y1="336" x2="300" y2="336" stroke="var(--color-ink)" stroke-width="3" />
      <rect x="188" y="336" width="112" height="80" fill="url(#netMesh)" opacity="0.8" />
      <rect x="188" y="333" width="112" height="6" fill="#f4efe4" stroke="var(--color-ink)" stroke-width="1.5" />
    </g>

    <!-- player shadow -->
    <ellipse cx="340" cy="560" rx="78" ry="12" fill="var(--color-ink)" opacity="0.14" />

    <!-- player -->
    <g id="player-body">
      <!-- back leg (extended) -->
      <path d="M352 438 Q364 480 372 536" stroke="url(#skinGrad)" stroke-width="22" stroke-linecap="round" fill="none" />
      <line x1="369" y1="523" x2="373" y2="537" stroke="#f4efe4" stroke-width="20" stroke-linecap="round" />
      <g>
        <rect x="358" y="534" width="34" height="17" rx="8" fill="var(--color-ink)" />
        <line x1="368" y1="536" x2="368" y2="542" stroke="#f4efe4" stroke-width="2" />
        <line x1="375" y1="535" x2="375" y2="541" stroke="#f4efe4" stroke-width="2" />
        <rect x="356" y="549" width="38" height="5" rx="2.5" fill="var(--color-amber)" />
      </g>

      <!-- front leg (bent, weight forward) -->
      <path d="M328 436 Q304 466 299 508 Q296 524 298 538" stroke="url(#skinGrad)" stroke-width="22" stroke-linecap="round" fill="none" />
      <line x1="298" y1="523" x2="298" y2="537" stroke="#f4efe4" stroke-width="20" stroke-linecap="round" />
      <g>
        <rect x="281" y="535" width="36" height="17" rx="8" fill="var(--color-ink)" />
        <line x1="291" y1="537" x2="291" y2="543" stroke="#f4efe4" stroke-width="2" />
        <line x1="299" y1="536" x2="299" y2="542" stroke="#f4efe4" stroke-width="2" />
        <rect x="279" y="550" width="40" height="5" rx="2.5" fill="var(--color-amber)" />
      </g>

      <!-- shorts -->
      <path d="M306 414 Q343 398 384 414 L390 448 Q345 464 302 448 Z" fill="url(#shortsGrad)" />

      <!-- off arm (tucked, behind torso) -->
      <path d="M320 356 Q300 380 296 408" stroke="url(#skinGrad)" stroke-width="15" stroke-linecap="round" fill="none" />
      <ellipse cx="295" cy="412" rx="8" ry="7" fill="url(#skinGrad)" />
      <line x1="291" y1="417" x2="290" y2="423" stroke="url(#skinGrad)" stroke-width="3" stroke-linecap="round" />
      <line x1="296" y1="419" x2="296" y2="426" stroke="url(#skinGrad)" stroke-width="3" stroke-linecap="round" />
      <line x1="301" y1="417" x2="303" y2="423" stroke="url(#skinGrad)" stroke-width="3" stroke-linecap="round" />

      <!-- torso (forward lean) -->
      <path d="M300 346 Q340 328 374 348 L380 430 Q343 447 308 429 Z" fill="url(#shirtGrad)" />

      <!-- neck + head -->
      <rect x="326" y="316" width="20" height="18" fill="url(#skinGrad)" />
      <circle cx="336" cy="296" r="28" fill="url(#skinGrad)" />
      <circle cx="311" cy="298" r="4" fill="url(#skinGrad)" />
      <path d="M308 294 a28 28 0 0 1 56 -4 q-12 -9 -28 -9 t-28 9 q0 2 0 4z" fill="var(--color-ink)" />

      <!-- face -->
      <line x1="318" y1="292" x2="328" y2="289" stroke="var(--color-ink)" stroke-width="2.2" stroke-linecap="round" />
      <circle cx="320" cy="296" r="2.4" fill="var(--color-ink)" />
      <circle cx="332" cy="296" r="2.4" fill="var(--color-ink)" />
      <line x1="327" y1="299" x2="325" y2="304" stroke="#c99569" stroke-width="1.6" stroke-linecap="round" opacity="0.7" />
      <path d="M318 310 q7 3 14 0" stroke="var(--color-ink)" stroke-width="1.8" fill="none" stroke-linecap="round" />
      <path d="M316 314 q12 6 24 0" stroke="#c99569" stroke-width="1.4" opacity="0.35" fill="none" />
    </g>

    <g id="racket-arm">
      <path d="M322 352 Q305 380 300 410" stroke="url(#skinGrad)" stroke-width="16" stroke-linecap="round" fill="none" />
      <path d="M300 410 Q292 435 286 456" stroke="url(#skinGrad)" stroke-width="14" stroke-linecap="round" fill="none" />
      <rect x="279" y="443" width="17" height="8" rx="4" fill="var(--color-amber)" />
      <ellipse cx="285" cy="458" rx="9" ry="8" fill="url(#skinGrad)" />
      <line x1="279" y1="453" x2="291" y2="453" stroke="var(--color-ink)" stroke-width="2" opacity="0.45" />
      <line x1="278" y1="460" x2="290" y2="460" stroke="var(--color-ink)" stroke-width="2" opacity="0.45" />
      <line x1="285" y1="458" x2="272" y2="490" stroke="var(--color-ink)" stroke-width="5" stroke-linecap="round" />
      <ellipse cx="264" cy="512" rx="20" ry="27" fill="none" stroke="var(--color-ink)" stroke-width="4" transform="rotate(-18 264 512)" />
      <ellipse cx="264" cy="512" rx="13" ry="20" fill="var(--color-amber)" opacity="0.3" transform="rotate(-18 264 512)" />
      <path d="M251 494 L277 530 M277 494 L251 530 M258 488 L270 536 M244 505 L284 519" stroke="var(--color-ink)" stroke-width="1.1" opacity="0.5" transform="rotate(-18 264 512)" />
    </g>

    <g id="shuttlecock">
      <circle cx="296" cy="416" r="5" fill="var(--color-terracotta)" />
      <path d="M296 416 L286 394 L306 394 Z" fill="#f4efe4" stroke="var(--color-ink)" stroke-width="1.8" />
    </g>

    <g id="impact-burst" opacity="0">
      <path d="M296 416 l13 -8 M296 416 l16 6 M296 416 l-2 17 M296 416 l-15 -5" stroke="var(--color-amber)" stroke-width="4" stroke-linecap="round" />
    </g>
  </svg>
</div>

<style>
  .scene-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
    min-height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--color-ink);
  }

  .badminton-scene {
    width: 100%;
    height: 100%;
    display: block;
  }

  #racket-arm {
    transform-origin: 322px 352px;
  }

  #player-body {
    transform-origin: 340px 440px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .badminton-scene.is-serving #racket-arm {
      animation: racket-swing 1s cubic-bezier(0.3, 0, 0.2, 1);
    }

    .badminton-scene.is-serving #player-body {
      animation: body-lean 1s ease-in-out;
    }

    .badminton-scene.is-serving #shuttlecock {
      animation: shuttle-fly 1s cubic-bezier(0.3, 0, 0.2, 1);
    }

    .badminton-scene.is-serving #impact-burst {
      animation: burst-flash 1s ease-in-out;
    }
  }

  @keyframes racket-swing {
    0% { transform: rotate(0deg); }
    25% { transform: rotate(-14deg); }
    55% { transform: rotate(68deg); }
    80% { transform: rotate(88deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes body-lean {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    55% { transform: translate(-4px, -3px) rotate(-2deg); }
    80% { transform: translate(1px, 0) rotate(1deg); }
  }

  @keyframes shuttle-fly {
    0%, 50% { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    54% { opacity: 1; }
    100% { transform: translate(-196px, -156px) rotate(-140deg); opacity: 0; }
  }

  @keyframes burst-flash {
    0%, 48% { opacity: 0; transform: scale(0.6); }
    55% { opacity: 1; transform: scale(1.1); }
    68% { opacity: 0; transform: scale(1.4); }
    100% { opacity: 0; }
  }

  @media (max-width: 900px) {
    .scene-wrap {
      min-height: 320px;
    }
  }
</style>

<script>
  const scene = document.getElementById('badminton-scene');

  window.addEventListener('contact:serve', () => {
    if (!scene) return;
    scene.classList.remove('is-serving');
    void scene.getBoundingClientRect();
    scene.classList.add('is-serving');
  });
</script>
