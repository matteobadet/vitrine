---
interface Props {
  id: string;
  x: number;
  y: number;
  scale?: number;
  flip?: boolean;
  skin?: string;
  skinShade?: string;
  top?: string;
  topShade?: string;
  bottom?: string;
  bottomShade?: string;
  shoe?: string;
  hair?: string;
  helmet?: string;
  helmetShade?: string;
  motionClass?: string;
  armFrontAngle?: number;
  armBackAngle?: number;
  forearmFrontAngle?: number;
  forearmBackAngle?: number;
  thighFrontAngle?: number;
  thighBackAngle?: number;
  shinFrontAngle?: number;
  shinBackAngle?: number;
}

const {
  id,
  x,
  y,
  scale = 1,
  flip = false,
  skin = '#e8b48a',
  skinShade = '#cf9a6f',
  top = '#d97a4d',
  topShade = '#b85f37',
  bottom = '#1c1a22',
  bottomShade = '#312e3a',
  shoe = '#241f2e',
  hair = '#2b2320',
  helmet = '',
  helmetShade = '',
  motionClass = '',
  armFrontAngle = 0,
  armBackAngle = 0,
  forearmFrontAngle = 0,
  forearmBackAngle = 0,
  thighFrontAngle = 0,
  thighBackAngle = 0,
  shinFrontAngle = 0,
  shinBackAngle = 0,
} = Astro.props;

const flipScale = flip ? -1 : 1;
const g = (name: string) => `url(#${id}-${name})`;
---

<g
  class={`fig ${motionClass}`}
  data-fig-id={id}
  transform={`translate(${x} ${y}) scale(${scale * flipScale} ${scale})`}
>
  <defs>
    <linearGradient id={`${id}-skin`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={skin} />
      <stop offset="100%" stop-color={skinShade} />
    </linearGradient>
    <linearGradient id={`${id}-top`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={top} />
      <stop offset="100%" stop-color={topShade} />
    </linearGradient>
    <linearGradient id={`${id}-bottom`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={bottom} />
      <stop offset="100%" stop-color={bottomShade} />
    </linearGradient>
    <linearGradient id={`${id}-torso`} x1="0" y1="1" x2="0.6" y2="0">
      <stop offset="0%" stop-color={topShade} />
      <stop offset="100%" stop-color={top} />
    </linearGradient>
    {helmet && (
      <linearGradient id={`${id}-helmet`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={helmet} />
        <stop offset="100%" stop-color={helmetShade || helmet} />
      </linearGradient>
    )}
  </defs>

  <!-- back arm -->
  <g transform={`rotate(${armBackAngle})`}>
    <g class="fig-arm-back-pivot">
      <rect x="-3.5" y="-1" width="7" height="24" rx="3.5" fill={g('top')} />
      <g transform="translate(0,22)">
        <g transform={`rotate(${forearmBackAngle})`}>
          <g class="fig-forearm-back-pivot">
            <rect x="-3" y="-1" width="6" height="19" rx="3" fill={g('skin')} />
            <circle cx="0" cy="19" r="3.4" fill={g('skin')} />
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- back leg -->
  <g transform={`rotate(${thighBackAngle})`}>
    <g class="fig-thigh-back-pivot">
      <rect x="-5" y="-1" width="10" height="26" rx="4.5" fill={g('bottom')} />
      <g transform="translate(0,24)">
        <g transform={`rotate(${shinBackAngle})`}>
          <g class="fig-shin-back-pivot">
            <rect x="-4" y="-1" width="8" height="27" rx="3.5" fill={g('bottom')} />
            <path d="M-3,23 Q-3,29 3,29 L12,31 Q13,33 11,34 L-4,34 Q-6,34 -6,31 Z" fill={shoe} />
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- torso -->
  <g class="fig-torso">
    <path d="M-8,-2 Q-9,-24 -7,-46 L15,-46 Q17,-24 8,-2 Z" fill={g('torso')} />

    <!-- head + face + optional helmet -->
    <g transform="translate(11,-46)">
      <path d="M-13,-6 Q-13,-19 0,-19 Q13,-19 13,-6 L13,-2 Q13,5 4,5 L-8,5 Q-13,5 -13,-2 Z" fill={g('skin')} />
      <circle cx="-3.5" cy="-6" r="1.4" fill="#2b2320" />
      <circle cx="5" cy="-6" r="1.4" fill="#2b2320" />
      <path d="M-2,0 Q2,2.4 6,0" stroke="#a9744e" stroke-width="1.1" fill="none" stroke-linecap="round" />
      <path d="M-13,-9 Q-13,-22 0,-22 Q13,-22 13,-9 L13,-13 Q13,-19 0,-19 Q-13,-19 -13,-13 Z" fill={hair} />
      {helmet && (
        <path d="M-14,-10 Q-14,-26 0,-26 Q14,-26 14,-10 L14,-15 Q14,-23 0,-23 Q-14,-23 -14,-15 Z" fill={g('helmet')} />
      )}
    </g>

    <!-- front arm (drawn after torso so it sits on top) -->
    <g transform="translate(11,-42)">
      <g transform={`rotate(${armFrontAngle})`}>
        <g class="fig-arm-front-pivot">
          <rect x="-3.5" y="-1" width="7" height="24" rx="3.5" fill={g('top')} />
          <g transform="translate(0,22)">
            <g transform={`rotate(${forearmFrontAngle})`}>
              <g class="fig-forearm-front-pivot">
                <rect x="-3.2" y="-1" width="6.4" height="19" rx="3.2" fill={g('skin')} />
                <circle cx="0" cy="19" r="3.6" fill={g('skin')} />
              </g>
            </g>
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- front leg (drawn last, in front) -->
  <g transform={`rotate(${thighFrontAngle})`}>
    <g class="fig-thigh-front-pivot">
      <rect x="-5.2" y="-1" width="10.4" height="26" rx="4.8" fill={g('bottom')} />
      <g transform="translate(0,24)">
        <g transform={`rotate(${shinFrontAngle})`}>
          <g class="fig-shin-front-pivot">
            <rect x="-4.2" y="-1" width="8.4" height="27" rx="3.8" fill={g('bottom')} />
            <path d="M-3.2,23 Q-3.2,30 3.2,30 L13,32 Q14,34 12,35 L-4.5,35 Q-6.5,35 -6.5,32 Z" fill={shoe} />
          </g>
        </g>
      </g>
    </g>
  </g>
</g>
