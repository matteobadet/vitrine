---
import LowPolyFigure from './LowPolyFigure.astro';
---

<div class="climbing-scene">
  <svg
    class="climbing-svg"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="climbSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7fa8d9" />
        <stop offset="45%" stop-color="#bcd0ea" />
        <stop offset="100%" stop-color="#e6ddec" />
      </linearGradient>
      <linearGradient id="warmLight" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f6dfc4" />
        <stop offset="100%" stop-color="#e3bd94" />
      </linearGradient>
      <linearGradient id="warmMid" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#d9ae86" />
        <stop offset="100%" stop-color="#bd8c66" />
      </linearGradient>
      <linearGradient id="coolShadow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#7d8ba6" />
        <stop offset="100%" stop-color="#606f8c" />
      </linearGradient>
      <linearGradient id="coolDark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#606f8c" />
        <stop offset="100%" stop-color="#495371" />
      </linearGradient>
      <linearGradient id="farHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#a8bfdd" />
        <stop offset="100%" stop-color="#93add0" />
      </linearGradient>
      <linearGradient id="cloudGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#dbe4f2" />
      </linearGradient>
      <linearGradient id="holdShine" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1440" height="700" fill="url(#climbSky)" />

    <polygon points="0,340 220,230 460,330 700,210 1000,340 1440,240 1440,560 0,560" fill="url(#farHaze)" opacity="0.6" />

    <g class="cloud" fill="url(#cloudGrad)" opacity="0.85">
      <ellipse cx="170" cy="130" rx="80" ry="28" />
      <ellipse cx="240" cy="112" rx="58" ry="24" />
    </g>
    <g class="cloud cloud-2" fill="url(#cloudGrad)" opacity="0.7">
      <ellipse cx="520" cy="95" rx="60" ry="22" />
      <ellipse cx="580" cy="110" rx="45" ry="16" />
    </g>

    <!-- rock face the figure climbs, faceted with warm/cool light like the mountains -->
    <polygon points="580,700 540,520 650,440 590,320 690,240 630,120 730,30 780,-10 1440,-10 1440,700" fill="url(#coolShadow)" />
    <polygon points="580,700 540,520 650,440 650,700" fill="url(#warmMid)" />
    <polygon points="650,440 590,320 690,240 690,440" fill="url(#coolDark)" />
    <polygon points="690,240 630,120 730,30 730,240" fill="url(#warmLight)" />
    <polygon points="730,30 780,-10 900,-10 900,260 730,240" fill="url(#warmMid)" />
    <polygon points="900,-10 1150,-10 1150,320 900,300" fill="url(#coolShadow)" />
    <polygon points="900,300 1150,320 1050,480 850,470" fill="url(#warmLight)" />
    <polygon points="850,470 1050,480 950,700 700,700" fill="url(#coolDark)" />

    <g stroke="#4b5468" stroke-width="2.5" fill="none" opacity="0.35">
      <path d="M700,600 630,560 690,500" />
      <path d="M790,420 730,390 770,330" />
      <path d="M840,220 780,190 820,120" />
      <path d="M980,380 1040,350 1000,290" />
    </g>

    <!-- climbing holds -->
    <g class="holds">
      <g>
        <polygon points="900,180 924,168 936,192 916,210 892,200" fill="#e0834f" />
        <polygon points="900,180 924,168 918,178" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="780,300 800,288 812,308 794,322 775,314" fill="#f0b93e" />
        <polygon points="780,300 800,288 794,296" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="950,380 972,372 982,394 962,408 942,398" fill="#4d9be0" />
        <polygon points="950,380 972,372 964,382" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="820,470 842,462 852,482 834,496 814,486" fill="#3f8a5f" />
        <polygon points="820,470 842,462 834,470" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="1020,260 1040,252 1050,272 1032,286 1014,276" fill="#f0b93e" />
        <polygon points="1020,260 1040,252 1032,260" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="1060,460 1082,452 1092,474 1072,488 1052,478" fill="#e0834f" />
        <polygon points="1060,460 1082,452 1074,460" fill="url(#holdShine)" />
      </g>
      <g>
        <polygon points="880,560 902,552 912,572 894,586 874,576" fill="#4d9be0" />
        <polygon points="880,560 902,552 894,560" fill="url(#holdShine)" />
      </g>
    </g>
  </svg>

  <div class="climber-offset">
  <g class="climber-wrap">
    <svg
      class="climber-svg"
      viewBox="0 0 1440 700"
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
      focusable="false"
    >
      <LowPolyFigure
        id="climber"
        x={850}
        y={430}
        scale={2.4}
        top="#3a8fd9"
        topShade="#2a6ba8"
        bottom="#232030"
        bottomShade="#171420"
        armFrontAngle={165}
        forearmFrontAngle={15}
        armBackAngle={-70}
        forearmBackAngle={60}
        thighFrontAngle={-130}
        shinFrontAngle={90}
        thighBackAngle={-15}
        shinBackAngle={20}
      />
    </svg>
  </g>
  </div>

  <div class="chalk-puff" aria-hidden="true"></div>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style>
  .climbing-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .climbing-svg,
  .climber-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .climbing-svg {
    z-index: -2;
  }

  .climber-offset {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .climber-wrap {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cloud { animation: drift 55s linear infinite; }
    .cloud-2 { animation-duration: 70s; animation-delay: -25s; }

    .climber-wrap {
      animation: sway 6s ease-in-out infinite;
      transform-origin: 70% 65%;
    }
  }

  @keyframes drift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-70px); }
    100% { transform: translateX(0); }
  }

  @keyframes sway {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(-0.6deg); }
  }

  .chalk-puff {
    position: absolute;
    left: 67%;
    top: 26%;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chalk-puff {
      animation: puff 6s ease-out infinite;
    }
  }

  @keyframes puff {
    0%, 60% { opacity: 0; transform: scale(0.4); }
    68% { opacity: 0.85; transform: scale(1); }
    85% { opacity: 0; transform: scale(1.8); }
    100% { opacity: 0; transform: scale(0.4); }
  }

  @media (max-width: 720px) {
    .climber-wrap {
      opacity: 0.5;
    }

    .chalk-puff {
      display: none;
    }
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.94);
    border-radius: 28px;
    box-shadow: 0 20px 60px -20px rgba(20, 20, 30, 0.35);
    padding: 3rem 3rem 3rem 2.5rem;
    max-width: 620px;
    margin-inline: 1rem;
  }

  @media (min-width: 721px) and (max-width: 920px) {
    .hero-panel {
      max-width: 460px;
      padding: 2.5rem 2rem;
    }

    .climber-offset {
      transform: translateX(8%);
    }
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 2rem 1.5rem;
    }
  }
</style>
