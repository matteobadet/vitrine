---
import LowPolyFigure from './LowPolyFigure.astro';
---

<div class="climbing-scene">
  <svg
    class="climbing-svg"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="climbSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1d63c9" />
        <stop offset="100%" stop-color="#bcd8f5" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1440" height="700" fill="url(#climbSky)" />

    <g class="cloud" fill="#ffffff" opacity="0.55">
      <ellipse cx="180" cy="120" rx="75" ry="26" />
      <ellipse cx="250" cy="105" rx="55" ry="20" />
    </g>
    <g class="cloud cloud-2" fill="#ffffff" opacity="0.45">
      <ellipse cx="520" cy="90" rx="60" ry="22" />
      <ellipse cx="580" cy="105" rx="45" ry="16" />
    </g>

    <g id="cliff-back" fill="#4d78b0" opacity="0.5">
      <polygon points="260,480 420,240 620,480" />
      <polygon points="520,480 700,320 880,480" />
    </g>

    <!-- rock face: low-poly faceted cliff the figure climbs -->
    <polygon points="600,700 560,540 660,460 610,340 700,260 650,140 740,40 780,-10 1440,-10 1440,700" fill="#8a8f7d" />
    <g opacity="0.85">
      <polygon points="600,700 560,540 660,460 660,700" fill="#767b69" />
      <polygon points="660,460 610,340 700,260 700,460" fill="#9a9f8c" />
      <polygon points="700,260 650,140 740,40 740,260" fill="#767b69" />
      <polygon points="740,40 780,-10 900,-10 900,300 740,260" fill="#9a9f8c" />
    </g>
    <g stroke="#5c6152" stroke-width="3" fill="none" opacity="0.5">
      <path d="M690,600 620,560 680,500" />
      <path d="M780,420 720,390 760,330" />
      <path d="M820,220 760,190 800,120" />
    </g>

    <!-- climbing holds -->
    <g class="holds">
      <polygon points="900,180 924,168 936,192 916,210 892,200" fill="#d97a4d" />
      <polygon points="780,300 800,288 812,308 794,322 775,314" fill="#e0a83a" />
      <polygon points="950,380 972,372 982,394 962,408 942,398" fill="#3a8fd9" />
      <polygon points="820,470 842,462 852,482 834,496 814,486" fill="#2f6b4f" />
      <polygon points="1020,260 1040,252 1050,272 1032,286 1014,276" fill="#e0a83a" />
      <polygon points="1060,460 1082,452 1092,474 1072,488 1052,478" fill="#d97a4d" />
      <polygon points="880,560 902,552 912,572 894,586 874,576" fill="#3a8fd9" />
    </g>
  </svg>

  <g class="climber-wrap">
    <svg
      class="climber-svg"
      viewBox="0 0 1440 700"
      preserveAspectRatio="xMidYMax slice"
      aria-hidden="true"
      focusable="false"
    >
      <LowPolyFigure
        id="climber"
        x={850}
        y={430}
        scale={2.4}
        top="#3a8fd9"
        topShade="#2a6ba8"
        bottom="#1c1a22"
        bottomShade="#312e3a"
        armFrontAngle={165}
        forearmFrontAngle={15}
        armBackAngle={-70}
        forearmBackAngle={60}
        thighFrontAngle={-130}
        shinFrontAngle={90}
        thighBackAngle={-15}
        shinBackAngle={20}
      />
    </svg>
  </g>

  <div class="chalk-puff" aria-hidden="true"></div>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style>
  .climbing-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .climbing-svg,
  .climber-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .climbing-svg {
    z-index: -2;
  }

  .climber-wrap {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cloud { animation: drift 55s linear infinite; }
    .cloud-2 { animation-duration: 70s; animation-delay: -25s; }

    .climber-wrap {
      animation: sway 6s ease-in-out infinite;
      transform-origin: 70% 65%;
    }
  }

  @keyframes drift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-70px); }
    100% { transform: translateX(0); }
  }

  @keyframes sway {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(-0.6deg); }
  }

  .chalk-puff {
    position: absolute;
    left: 67%;
    top: 26%;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0) 70%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chalk-puff {
      animation: puff 6s ease-out infinite;
    }
  }

  @keyframes puff {
    0%, 60% { opacity: 0; transform: scale(0.4); }
    68% { opacity: 0.85; transform: scale(1); }
    85% { opacity: 0; transform: scale(1.8); }
    100% { opacity: 0; transform: scale(0.4); }
  }

  @media (max-width: 720px) {
    .climber-wrap {
      opacity: 0.5;
    }

    .chalk-puff {
      display: none;
    }
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.9);
    backdrop-filter: blur(6px);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
    max-width: 560px;
    margin-inline: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 1.75rem;
      margin-inline: 1rem;
    }
  }
</style>
