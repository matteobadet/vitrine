<style>
  .climbing-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .climbing-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.86);
    backdrop-filter: blur(6px);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
    max-width: 560px;
    margin-inline: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    #arm-left { animation: reach-a 2.6s ease-in-out infinite; transform-origin: -20px 84px; }
    #arm-right { animation: reach-b 2.3s ease-in-out infinite; transform-origin: 28px 82px; }
    #leg-left { animation: reach-b 2.8s ease-in-out infinite; transform-origin: 0px 130px; }
    #leg-right { animation: reach-a 2.4s ease-in-out infinite; transform-origin: 10px 130px; }
    #climber-pos { animation: sway 4.5s ease-in-out infinite; }
  }

  @keyframes reach-a {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(-5deg); }
  }

  @keyframes reach-b {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(5deg); }
  }

  @keyframes sway {
    0%, 100% { transform: translate(960px, 220px) rotate(0deg); }
    50% { transform: translate(960px, 220px) rotate(1.5deg); }
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 1.75rem;
      margin-inline: 1rem;
    }
  }
</style>
