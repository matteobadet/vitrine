---
import { buildScene, type Variant } from '../lib/scenes';

interface Props {
  variant: Variant;
  sparkTrigger?: string;
}

const { variant, sparkTrigger = '' } = Astro.props;
const { svg, css } = buildScene(variant);
---

<div class="lp-scene" id="lp-scene" data-mode="day">
  <svg
    class="lp-svg"
    viewBox="0 0 1440 800"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
    set:html={svg}
  />

  <button type="button" id="mode-toggle" class="mode-toggle" aria-label="Basculer jour / nuit">
    <span class="mode-icon icon-day" aria-hidden="true">☀️</span>
    <span class="mode-icon icon-night" aria-hidden="true">🌙</span>
  </button>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style is:inline set:html={css}></style>

<script is:inline define:vars={{ sparkTrigger }}>
  (function () {
    var scene = document.getElementById('lp-scene');
    var toggle = document.getElementById('mode-toggle');
    if (!scene || !toggle) return;
    try {
      if (localStorage.getItem('mbadet-hero-mode') === 'night') scene.dataset.mode = 'night';
    } catch (e) {}
    toggle.addEventListener('click', function () {
      var next = scene.dataset.mode === 'night' ? 'day' : 'night';
      scene.dataset.mode = next;
      try {
        localStorage.setItem('mbadet-hero-mode', next);
      } catch (e) {}
    });
    if (sparkTrigger) {
      window.addEventListener(sparkTrigger, function () {
        scene.classList.remove('is-sparking');
        void scene.getBoundingClientRect();
        scene.classList.add('is-sparking');
        setTimeout(function () {
          scene.classList.remove('is-sparking');
        }, 1100);
      });
    }
  })();
</script>

<style>
  .lp-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 5.5rem 3rem;
    background: #a9b8ea;
  }

  .lp-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lp-svg :global(polygon) {
    stroke-width: 1;
    stroke-linejoin: round;
    transition: fill 1.2s ease, stroke 1.2s ease;
  }

  .lp-svg :global(.dn-day),
  .lp-svg :global(.dn-night) {
    transition: opacity 1.2s ease;
  }

  .lp-svg :global(.dn-night) {
    opacity: 0;
  }

  .lp-scene[data-mode='night'] :global(.dn-night) {
    opacity: 1;
  }

  .lp-scene[data-mode='night'] :global(.dn-day) {
    opacity: 0;
  }

  .lp-svg :global(.gl) {
    fill: #ffffff;
    opacity: 0.55;
  }

  .lp-scene[data-mode='night'] :global(.gl) {
    fill: #c9d1ff;
    opacity: 0.35;
  }

  .lp-svg :global(.sparks circle) {
    opacity: 0;
  }

  .mode-toggle {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 2;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.7);
    background: rgba(255, 252, 246, 0.85);
    backdrop-filter: blur(8px);
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px -12px rgba(40, 30, 80, 0.5);
    transition: transform 0.15s ease;
  }

  .mode-toggle:hover {
    transform: scale(1.06);
  }

  .icon-night {
    display: none;
  }

  .lp-scene[data-mode='night'] .icon-day {
    display: none;
  }

  .lp-scene[data-mode='night'] .icon-night {
    display: inline;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 251, 245, 0.9);
    backdrop-filter: blur(10px) saturate(1.15);
    -webkit-backdrop-filter: blur(10px) saturate(1.15);
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 28px;
    box-shadow: 0 30px 70px -25px rgba(40, 30, 80, 0.5);
    padding: 3rem 3rem 3rem 2.5rem;
    max-width: 600px;
    margin-inline: clamp(1rem, 4vw, 4.5rem);
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 2rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .lp-svg :global(.drift) {
      animation: lp-drift 70s ease-in-out infinite alternate;
    }
    .lp-svg :global(.d2) {
      animation-duration: 90s;
      animation-direction: alternate-reverse;
    }
    .lp-svg :global(.d3) {
      animation-duration: 55s;
    }
    .lp-svg :global(.tw) {
      animation: lp-twinkle 3.5s ease-in-out infinite;
    }
    .lp-svg :global(.gl) {
      animation: lp-glint 4s ease-in-out infinite;
    }
    .lp-svg :global(.sway) {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: lp-sway 5.5s ease-in-out infinite alternate;
    }
    .lp-svg :global(.flame) {
      transform-box: fill-box;
      transform-origin: 50% 100%;
    }
    .lp-svg :global(.flame-1) {
      animation: lp-flicker-a 1.1s ease-in-out infinite;
    }
    .lp-svg :global(.flame-2) {
      animation: lp-flicker-b 0.9s ease-in-out infinite;
    }
    .lp-svg :global(.flame-3) {
      animation: lp-flicker-b 1.3s ease-in-out infinite 0.2s;
    }
    .lp-svg :global(.flame-4) {
      animation: lp-flicker-a 0.8s ease-in-out infinite 0.1s;
    }
    .lp-svg :global(.ember) {
      animation: lp-rise 2.6s ease-in infinite;
    }
    .lp-svg :global(.ember-2) {
      animation-delay: 0.6s;
    }
    .lp-svg :global(.ember-3) {
      animation-delay: 1.3s;
    }
    .lp-svg :global(.ember-4) {
      animation-delay: 1.9s;
    }
    .lp-svg :global(.ff) {
      animation: lp-firefly 6s ease-in-out infinite;
    }
    .lp-svg :global(.birds) {
      animation: lp-birds 40s linear infinite;
    }
    .lp-svg :global(.flag) {
      transform-box: fill-box;
      transform-origin: 0% 50%;
      animation: lp-flag 2.4s ease-in-out infinite;
    }
    .lp-scene.is-sparking :global(.sparks circle) {
      animation: lp-spark 1s ease-out forwards;
    }
  }

  .lp-scene :global(.spark-1) { --dx: -22px; }
  .lp-scene :global(.spark-2) { --dx: 26px; animation-delay: 0.05s; }
  .lp-scene :global(.spark-3) { --dx: -36px; animation-delay: 0.1s; }
  .lp-scene :global(.spark-4) { --dx: 38px; animation-delay: 0.03s; }
  .lp-scene :global(.spark-5) { --dx: 4px; animation-delay: 0.08s; }
  .lp-scene :global(.spark-6) { --dx: 14px; animation-delay: 0.12s; }

  @keyframes lp-drift {
    from { transform: translateX(-30px); }
    to { transform: translateX(30px); }
  }

  @keyframes lp-twinkle {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  @keyframes lp-glint {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 0.75; }
  }

  @keyframes lp-sway {
    from { transform: rotate(-1.8deg); }
    to { transform: rotate(1.8deg); }
  }

  @keyframes lp-flicker-a {
    0%, 100% { transform: scaleY(1) scaleX(1) skewX(0deg); }
    50% { transform: scaleY(1.12) scaleX(0.94) skewX(-3deg); }
  }

  @keyframes lp-flicker-b {
    0%, 100% { transform: scaleY(1) scaleX(1) skewX(0deg); }
    50% { transform: scaleY(0.9) scaleX(1.06) skewX(3deg); }
  }

  @keyframes lp-rise {
    0% { transform: translate(0, 0); opacity: 0.9; }
    100% { transform: translate(6px, -64px); opacity: 0; }
  }

  @keyframes lp-firefly {
    0%, 100% { transform: translate(0, 0); opacity: 0.2; }
    30% { opacity: 1; }
    50% { transform: translate(14px, -18px); opacity: 0.9; }
    70% { opacity: 0.3; }
  }

  @keyframes lp-birds {
    from { transform: translate(-120px, 10px); }
    to { transform: translate(260px, -30px); }
  }

  @keyframes lp-flag {
    0%, 100% { transform: skewY(0deg) scaleX(1); }
    50% { transform: skewY(-6deg) scaleX(0.92); }
  }

  @keyframes lp-spark {
    0% { opacity: 1; transform: translate(0, 0) scale(1); }
    100% { opacity: 0; transform: translate(var(--dx, 10px), -80px) scale(0.4); }
  }
</style>
