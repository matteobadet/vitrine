---
interface Props {
  sparkTrigger?: string;
}
const { sparkTrigger = '' } = Astro.props;

// Foret generee : chaque sapin est 2 etages (silhouette faconnee) + tronc,
// avec un cote clair / cote ombre pour le rendu low-poly a facettes.
type Tree = { x: number; h: number; w: number; tone: number };

function seededTrees(count: number, xStart: number, xEnd: number, hMin: number, hMax: number, seed: number): Tree[] {
  const trees: Tree[] = [];
  let s = seed;
  const rand = () => {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
  for (let i = 0; i < count; i++) {
    const t = i / (count - 1);
    const x = xStart + t * (xEnd - xStart) + (rand() - 0.5) * ((xEnd - xStart) / count) * 0.8;
    const h = hMin + rand() * (hMax - hMin);
    const w = h * (0.34 + rand() * 0.1);
    const tone = Math.floor(rand() * 4);
    trees.push({ x, h, w, tone });
  }
  return trees;
}

const backTrees = seededTrees(26, -20, 1460, 40, 68, 11);
const frontTreesL = seededTrees(7, -60, 340, 90, 150, 42);
const frontTreesR = seededTrees(7, 1150, 1500, 90, 150, 73);

const dayTones = ['#5c8a6b', '#4d7a5c', '#3f6a4d', '#6a9878'];
const dayShades = ['#3f6a4d', '#356048', '#2b5039', '#4a7a5a'];
const nightTones = ['#1c3024', '#16281e', '#122016', '#20362a'];
const nightShades = ['#0f2018', '#0c1a13', '#09140f', '#122419'];
---

<div class="nature-scene" id="nature-scene" data-mode="day">
  <button type="button" id="mode-toggle" class="mode-toggle" aria-label="Basculer jour / nuit">
    <span class="mode-icon day-only" aria-hidden="true">☀️</span>
    <span class="mode-icon night-only" aria-hidden="true">🌙</span>
  </button>

  <svg
    class="nature-svg"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="skyDay" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#5f96d9" />
        <stop offset="45%" stop-color="#bfe3f5" />
        <stop offset="100%" stop-color="#eef6ee" />
      </linearGradient>
      <linearGradient id="skyNight" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#060a16" />
        <stop offset="100%" stop-color="#2c3a52" />
      </linearGradient>
      <linearGradient id="groundGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#cfe4c8" />
        <stop offset="100%" stop-color="#b7d4ac" />
      </linearGradient>
      <linearGradient id="groundGradNight" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#33473a" />
        <stop offset="100%" stop-color="#1a251c" />
      </linearGradient>
      <linearGradient id="tentGrad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e39264" />
        <stop offset="100%" stop-color="#c96a3a" />
      </linearGradient>
      <radialGradient id="fireGlowDay" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffb84d" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#ffb84d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="fireGlowNight" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffb84d" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#ffb84d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#eef2ff" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#eef2ff" stop-opacity="0" />
      </radialGradient>

      <linearGradient id="warmLight" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f6dfc4" />
        <stop offset="100%" stop-color="#e3bd94" />
      </linearGradient>
      <linearGradient id="warmMid" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#d9ae86" />
        <stop offset="100%" stop-color="#bd8c66" />
      </linearGradient>
      <linearGradient id="coolShadow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#7d9c8b" />
        <stop offset="100%" stop-color="#5f7d6d" />
      </linearGradient>
      <linearGradient id="coolDark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#5f7d6d" />
        <stop offset="100%" stop-color="#496152" />
      </linearGradient>
      <linearGradient id="farHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#b9cfe4" />
        <stop offset="100%" stop-color="#a3c2b8" />
      </linearGradient>

      <linearGradient id="nWarmLight" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4c5c86" />
        <stop offset="100%" stop-color="#3b4a70" />
      </linearGradient>
      <linearGradient id="nWarmMid" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#3b4a70" />
        <stop offset="100%" stop-color="#2c3a5c" />
      </linearGradient>
      <linearGradient id="nCoolShadow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#232d4a" />
        <stop offset="100%" stop-color="#181f38" />
      </linearGradient>
      <linearGradient id="nCoolDark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#181f38" />
        <stop offset="100%" stop-color="#0f1428" />
      </linearGradient>
      <linearGradient id="nFarHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2a3350" />
        <stop offset="100%" stop-color="#232c48" />
      </linearGradient>
    </defs>

    <!-- sky -->
    <rect class="day-only" x="0" y="0" width="1440" height="560" fill="url(#skyDay)" />
    <rect class="night-only" x="0" y="0" width="1440" height="560" fill="url(#skyNight)" />

    <!-- sun -->
    <g class="day-only">
      <circle cx="1220" cy="110" r="90" fill="#fff6d8" opacity="0.5" />
      <circle cx="1220" cy="110" r="52" fill="#ffdd7a" />
    </g>

    <!-- moon + stars -->
    <g class="night-only">
      <circle cx="1220" cy="110" r="80" fill="url(#moonGlow)" />
      <circle cx="1220" cy="110" r="42" fill="#f4f1e8" />
      <circle cx="1206" cy="98" r="34" fill="#2c3a52" opacity="0.5" />
      <g fill="#f4f1e8">
        <circle cx="180" cy="90" r="2.2" /><circle cx="260" cy="150" r="1.6" />
        <circle cx="340" cy="80" r="2" /><circle cx="430" cy="130" r="1.4" />
        <circle cx="520" cy="70" r="2.2" /><circle cx="640" cy="110" r="1.6" />
        <circle cx="760" cy="60" r="2" /><circle cx="860" cy="140" r="1.4" />
        <circle cx="960" cy="90" r="2.2" /><circle cx="1060" cy="50" r="1.6" />
        <circle cx="90" cy="180" r="1.4" /><circle cx="1360" cy="90" r="2" />
        <circle cx="500" cy="200" r="1.3" /><circle cx="820" cy="200" r="1.5" />
      </g>
    </g>

    <!-- clouds -->
    <g class="cloud day-only" fill="#ffffff" opacity="0.85">
      <ellipse cx="180" cy="130" rx="80" ry="28" />
      <ellipse cx="250" cy="112" rx="58" ry="24" />
    </g>
    <g class="cloud cloud-2 day-only" fill="#ffffff" opacity="0.7">
      <ellipse cx="560" cy="95" rx="60" ry="22" />
      <ellipse cx="620" cy="110" rx="45" ry="16" />
    </g>

    <!-- distant hazy ridge -->
    <polygon class="day-only" points="0,340 220,230 460,330 700,210 1000,340 1440,240 1440,560 0,560" fill="url(#farHaze)" opacity="0.6" />
    <polygon class="night-only" points="0,340 220,230 460,330 700,210 1000,340 1440,240 1440,560 0,560" fill="url(#nFarHaze)" opacity="0.7" />

    <!-- mid mountains, gradient-faceted -->
    <g class="day-only">
      <polygon points="0,480 100,360 160,420 220,320 300,420 380,480" fill="url(#coolShadow)" />
      <polygon points="0,480 100,360 160,420" fill="url(#warmMid)" />
      <polygon points="160,420 220,320 300,420" fill="url(#warmLight)" />
      <polygon points="880,480 990,340 1060,410 1140,300 1230,420 1320,480" fill="url(#coolShadow)" />
      <polygon points="880,480 990,340 1060,410" fill="url(#warmMid)" />
      <polygon points="1060,410 1140,300 1230,420" fill="url(#warmLight)" />
      <polygon points="1250,480 1340,380 1440,460 1440,480" fill="url(#coolDark)" />
    </g>
    <g class="night-only">
      <polygon points="0,480 100,360 160,420 220,320 300,420 380,480" fill="url(#nCoolShadow)" />
      <polygon points="0,480 100,360 160,420" fill="url(#nWarmMid)" />
      <polygon points="160,420 220,320 300,420" fill="url(#nWarmLight)" />
      <polygon points="880,480 990,340 1060,410 1140,300 1230,420 1320,480" fill="url(#nCoolShadow)" />
      <polygon points="880,480 990,340 1060,410" fill="url(#nWarmMid)" />
      <polygon points="1060,410 1140,300 1230,420" fill="url(#nWarmLight)" />
      <polygon points="1250,480 1340,380 1440,460 1440,480" fill="url(#nCoolDark)" />
    </g>

    <!-- near mountains, gradient-faceted -->
    <g class="day-only">
      <polygon points="-40,520 90,400 160,460 230,380 320,460 410,520" fill="url(#coolDark)" />
      <polygon points="-40,520 90,400 160,460" fill="url(#warmMid)" />
      <polygon points="160,460 230,380 320,460" fill="url(#warmLight)" />
      <polygon points="700,520 830,410 900,470 980,390 1080,470 1180,520" fill="url(#coolDark)" />
      <polygon points="700,520 830,410 900,470" fill="url(#warmMid)" />
      <polygon points="900,470 980,390 1080,470" fill="url(#warmLight)" />
      <polygon points="1200,520 1310,420 1440,510 1440,520" fill="url(#coolShadow)" />
    </g>
    <g class="night-only">
      <polygon points="-40,520 90,400 160,460 230,380 320,460 410,520" fill="url(#nCoolDark)" />
      <polygon points="-40,520 90,400 160,460" fill="url(#nWarmMid)" />
      <polygon points="160,460 230,380 320,460" fill="url(#nWarmLight)" />
      <polygon points="700,520 830,410 900,470 980,390 1080,470 1180,520" fill="url(#nCoolDark)" />
      <polygon points="700,520 830,410 900,470" fill="url(#nWarmMid)" />
      <polygon points="900,470 980,390 1080,470" fill="url(#nWarmLight)" />
      <polygon points="1200,520 1310,420 1440,510 1440,520" fill="url(#nCoolShadow)" />
    </g>

    <!-- foret arriere : ligne d'horizon dense de petits sapins -->
    <g class="day-only">
      {backTrees.map((t) => (
        <g transform={`translate(${t.x},540)`}>
          <polygon points={`0,${-t.h} ${-t.w},0 0,${-t.h * 0.35} ${t.w},0`} fill={dayTones[t.tone]} />
          <polygon points={`0,${-t.h} 0,${-t.h * 0.35} ${t.w},0`} fill={dayShades[t.tone]} />
        </g>
      ))}
    </g>
    <g class="night-only">
      {backTrees.map((t) => (
        <g transform={`translate(${t.x},540)`}>
          <polygon points={`0,${-t.h} ${-t.w},0 0,${-t.h * 0.35} ${t.w},0`} fill={nightTones[t.tone]} />
          <polygon points={`0,${-t.h} 0,${-t.h * 0.35} ${t.w},0`} fill={nightShades[t.tone]} />
        </g>
      ))}
    </g>

    <!-- ground -->
    <rect class="day-only" x="0" y="530" width="1440" height="170" fill="url(#groundGrad)" />
    <rect class="night-only" x="0" y="530" width="1440" height="170" fill="url(#groundGradNight)" />

    <!-- foret avant : sapins detailles a 2 etages, cadrant la scene -->
    <g class="day-only">
      {[...frontTreesL, ...frontTreesR].map((t) => (
        <g transform={`translate(${t.x},700)`}>
          <rect x={-t.w * 0.08} y={-t.h * 0.12} width={t.w * 0.16} height={t.h * 0.12} fill="#5a4331" />
          <polygon points={`0,${-t.h} ${-t.w * 0.55},${-t.h * 0.42} 0,${-t.h * 0.58} ${t.w * 0.55},${-t.h * 0.42}`} fill={dayTones[t.tone]} />
          <polygon points={`0,${-t.h} 0,${-t.h * 0.58} ${t.w * 0.55},${-t.h * 0.42}`} fill={dayShades[t.tone]} />
          <polygon points={`0,${-t.h * 0.62} ${-t.w},${-t.h * 0.05} 0,${-t.h * 0.3} ${t.w},${-t.h * 0.05}`} fill={dayTones[t.tone]} />
          <polygon points={`0,${-t.h * 0.62} 0,${-t.h * 0.3} ${t.w},${-t.h * 0.05}`} fill={dayShades[t.tone]} />
        </g>
      ))}
    </g>
    <g class="night-only">
      {[...frontTreesL, ...frontTreesR].map((t) => (
        <g transform={`translate(${t.x},700)`}>
          <rect x={-t.w * 0.08} y={-t.h * 0.12} width={t.w * 0.16} height={t.h * 0.12} fill="#1c140f" />
          <polygon points={`0,${-t.h} ${-t.w * 0.55},${-t.h * 0.42} 0,${-t.h * 0.58} ${t.w * 0.55},${-t.h * 0.42}`} fill={nightTones[t.tone]} />
          <polygon points={`0,${-t.h} 0,${-t.h * 0.58} ${t.w * 0.55},${-t.h * 0.42}`} fill={nightShades[t.tone]} />
          <polygon points={`0,${-t.h * 0.62} ${-t.w},${-t.h * 0.05} 0,${-t.h * 0.3} ${t.w},${-t.h * 0.05}`} fill={nightTones[t.tone]} />
          <polygon points={`0,${-t.h * 0.62} 0,${-t.h * 0.3} ${t.w},${-t.h * 0.05}`} fill={nightShades[t.tone]} />
        </g>
      ))}
    </g>

    <!-- tente -->
    <g id="tent" transform="translate(980,0)">
      <path d="M-20 580 L80 460 L180 580 Z" fill="url(#tentGrad)" />
      <path d="M40 580 L80 460 L120 580 Z" fill="#00000022" />
      <path d="M80 460 L80 580" stroke="#00000030" stroke-width="2" />
      <line x1="80" y1="460" x2="80" y2="446" stroke="var(--color-ink)" stroke-width="3" />
      <line x1="-20" y1="580" x2="-42" y2="598" stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round" />
      <line x1="180" y1="580" x2="202" y2="598" stroke="var(--color-ink)" stroke-width="3" stroke-linecap="round" />
      <path d="M40 580 Q80 520 120 580 Z" fill="#3a2a22" opacity="0.55" />
    </g>

    <!-- feu de camp -->
    <g id="campfire" transform="translate(560,610)">
      <ellipse class="day-only" cx="0" cy="6" rx="120" ry="34" fill="url(#fireGlowDay)" />
      <ellipse class="night-only" cx="0" cy="6" rx="160" ry="46" fill="url(#fireGlowNight)" />

      <g fill="#8a8a86">
        <ellipse cx="-38" cy="14" rx="11" ry="7" /><ellipse cx="-14" cy="20" rx="11" ry="7" />
        <ellipse cx="14" cy="20" rx="11" ry="7" /><ellipse cx="38" cy="14" rx="11" ry="7" />
        <ellipse cx="0" cy="24" rx="11" ry="7" />
      </g>

      <g stroke="#7a5236" stroke-width="9" stroke-linecap="round">
        <line x1="-28" y1="10" x2="24" y2="-6" />
        <line x1="-24" y1="-4" x2="28" y2="10" />
        <line x1="-30" y1="2" x2="30" y2="2" opacity="0.8" />
      </g>

      <g id="flames">
        <path class="flame flame-1" d="M0 4 C -14 -10 -8 -30 0 -46 C 8 -30 14 -10 0 4 Z" fill="#c9401f" />
        <path class="flame flame-2" d="M-10 4 C -18 -8 -12 -22 -8 -34 C -2 -20 2 -8 -10 4 Z" fill="#e8672a" />
        <path class="flame flame-3" d="M10 4 C 2 -8 8 -22 12 -32 C 18 -18 20 -6 10 4 Z" fill="#e8672a" />
        <path class="flame flame-4" d="M0 2 C -7 -6 -4 -16 0 -24 C 4 -16 7 -6 0 2 Z" fill="#ffcf5c" />
      </g>

      <g id="embers" fill="var(--color-amber)">
        <circle class="ember ember-1" cx="-6" cy="-30" r="2.4" />
        <circle class="ember ember-2" cx="8" cy="-24" r="2" />
        <circle class="ember ember-3" cx="-2" cy="-40" r="1.8" />
        <circle class="ember ember-4" cx="14" cy="-34" r="1.6" />
      </g>

      <g id="sparks" fill="#ffcf5c">
        <circle class="spark spark-1" cx="-4" cy="-20" r="1.6" />
        <circle class="spark spark-2" cx="10" cy="-18" r="1.4" />
        <circle class="spark spark-3" cx="-14" cy="-14" r="1.4" />
        <circle class="spark spark-4" cx="16" cy="-22" r="1.2" />
        <circle class="spark spark-5" cx="0" cy="-26" r="1.5" />
      </g>
    </g>
  </svg>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style>
  .nature-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .nature-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .night-only { display: none; }
  .nature-scene[data-mode='night'] .night-only { display: block; }
  .nature-scene[data-mode='night'] .day-only { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .cloud { animation: drift 55s linear infinite; }
    .cloud-2 { animation-duration: 70s; animation-delay: -25s; }
  }

  @keyframes drift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-70px); }
    100% { transform: translateX(0); }
  }

  .mode-toggle {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 2;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 2px solid var(--color-ink);
    background: var(--color-surface);
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-soft);
    transition: transform 0.15s ease;
  }

  .mode-toggle:hover {
    transform: scale(1.06);
  }

  .mode-icon.night-only {
    display: none;
  }

  .nature-scene[data-mode='night'] .mode-icon.day-only {
    display: none;
  }

  .nature-scene[data-mode='night'] .mode-icon.night-only {
    display: inline;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.94);
    border-radius: 28px;
    box-shadow: 0 20px 60px -20px rgba(20, 20, 30, 0.35);
    padding: 3rem 3rem 3rem 2.5rem;
    max-width: 620px;
    margin-inline: 1rem;
  }

  #flames {
    transform-origin: 0px 4px;
  }

  .flame {
    transform-origin: 0px 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flame-1 { animation: flicker-a 1.1s ease-in-out infinite; }
    .flame-2 { animation: flicker-b 0.9s ease-in-out infinite; }
    .flame-3 { animation: flicker-b 1.3s ease-in-out infinite 0.2s; }
    .flame-4 { animation: flicker-a 0.8s ease-in-out infinite 0.1s; }

    .ember { animation: rise 2.6s ease-in infinite; }
    .ember-1 { animation-delay: 0s; }
    .ember-2 { animation-delay: 0.6s; }
    .ember-3 { animation-delay: 1.3s; }
    .ember-4 { animation-delay: 1.9s; }
  }

  @keyframes flicker-a {
    0%, 100% { transform: scaleY(1) scaleX(1) skewX(0deg); }
    50% { transform: scaleY(1.12) scaleX(0.94) skewX(-3deg); }
  }

  @keyframes flicker-b {
    0%, 100% { transform: scaleY(1) scaleX(1) skewX(0deg); }
    50% { transform: scaleY(0.9) scaleX(1.06) skewX(3deg); }
  }

  @keyframes rise {
    0% { transform: translate(0, 0); opacity: 0.9; }
    100% { transform: translate(6px, -60px); opacity: 0; }
  }

  #sparks .spark {
    opacity: 0;
  }

  .nature-scene.is-sparking #sparks .spark {
    animation: spark-burst 0.9s ease-out forwards;
  }

  .spark-1 { animation-delay: 0s !important; }
  .spark-2 { animation-delay: 0.05s !important; }
  .spark-3 { animation-delay: 0.1s !important; }
  .spark-4 { animation-delay: 0.02s !important; }
  .spark-5 { animation-delay: 0.08s !important; }

  @keyframes spark-burst {
    0% { opacity: 1; transform: translate(0, 0) scale(1); }
    100% { opacity: 0; transform: translate(var(--dx, 10px), -70px) scale(0.5); }
  }

  .spark-1 { --dx: -18px; }
  .spark-2 { --dx: 22px; }
  .spark-3 { --dx: -30px; }
  .spark-4 { --dx: 34px; }
  .spark-5 { --dx: 4px; }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script define:vars={{ sparkTrigger }}>
  const scene = document.getElementById('nature-scene');
  const toggle = document.getElementById('mode-toggle');

  if (scene && toggle) {
    let stored = null;
    try {
      stored = localStorage.getItem('mbadet-hero-mode');
    } catch {
      stored = null;
    }
    if (stored === 'night') scene.dataset.mode = 'night';

    toggle.addEventListener('click', () => {
      const next = scene.dataset.mode === 'night' ? 'day' : 'night';
      scene.dataset.mode = next;
      try {
        localStorage.setItem('mbadet-hero-mode', next);
      } catch {
        /* ignore */
      }
    });
  }

  if (scene && sparkTrigger) {
    window.addEventListener(sparkTrigger, () => {
      scene.classList.remove('is-sparking');
      void scene.getBoundingClientRect();
      scene.classList.add('is-sparking');
      window.setTimeout(() => scene.classList.remove('is-sparking'), 1000);
    });
  }
</script>
