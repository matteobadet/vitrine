---
interface Props {
  frame?: string;
  wheelAnim?: string;
}
const { frame = '#1c1a22', wheelAnim = 'wheel-spin-a' } = Astro.props;
---

<g class="bike">
  <!-- frame -->
  <g stroke={frame} stroke-width="3.2" stroke-linecap="round" fill="none">
    <line x1="10" y1="36" x2="-6" y2="-4" />
    <line x1="-6" y1="-4" x2="32" y2="-20" />
    <line x1="10" y1="36" x2="32" y2="-20" />
    <line x1="10" y1="36" x2="-16" y2="36" />
    <line x1="-6" y1="-4" x2="-16" y2="36" />
    <line x1="32" y1="-20" x2="30" y2="36" />
    <line x1="26" y1="-25" x2="39" y2="-18" />
  </g>
  <circle cx="-6" cy="-8" r="3.5" fill={frame} />

  <!-- rear wheel -->
  <g class={`wheel ${wheelAnim}`} style="transform-origin: -16px 36px;">
    <circle cx="-16" cy="36" r="20" fill="none" stroke={frame} stroke-width="4.5" />
    <circle cx="-16" cy="36" r="4" fill={frame} />
    <g stroke={frame} stroke-width="1.6">
      <line x1="-16" y1="18" x2="-16" y2="54" />
      <line x1="-34" y1="36" x2="2" y2="36" />
      <line x1="-28.7" y1="23.3" x2="-3.3" y2="48.7" />
      <line x1="-28.7" y1="48.7" x2="-3.3" y2="23.3" />
    </g>
  </g>

  <!-- front wheel -->
  <g class={`wheel ${wheelAnim}`} style="transform-origin: 30px 36px;">
    <circle cx="30" cy="36" r="20" fill="none" stroke={frame} stroke-width="4.5" />
    <circle cx="30" cy="36" r="4" fill={frame} />
    <g stroke={frame} stroke-width="1.6">
      <line x1="30" y1="18" x2="30" y2="54" />
      <line x1="12" y1="36" x2="48" y2="36" />
      <line x1="17.3" y1="23.3" x2="42.7" y2="48.7" />
      <line x1="17.3" y1="48.7" x2="42.7" y2="23.3" />
    </g>
  </g>
</g>
