---
import LowPolyFigure from './LowPolyFigure.astro';
import LowPolyBike from './LowPolyBike.astro';
---

<div class="cycling-scene" id="cycling-scene">
  <svg
    class="cycling-svg"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="cycSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8fb0dd" />
        <stop offset="45%" stop-color="#c3d3ee" />
        <stop offset="100%" stop-color="#f0dfe6" />
      </linearGradient>
      <linearGradient id="warmLight" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f6dfc4" />
        <stop offset="100%" stop-color="#e3bd94" />
      </linearGradient>
      <linearGradient id="warmMid" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#d9ae86" />
        <stop offset="100%" stop-color="#bd8c66" />
      </linearGradient>
      <linearGradient id="coolShadow" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#8290b8" />
        <stop offset="100%" stop-color="#65739e" />
      </linearGradient>
      <linearGradient id="coolDark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#65739e" />
        <stop offset="100%" stop-color="#4e5a82" />
      </linearGradient>
      <linearGradient id="farHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#aec0e4" />
        <stop offset="100%" stop-color="#c1b8d9" />
      </linearGradient>
      <linearGradient id="cloudGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#dbe4f2" />
      </linearGradient>
      <linearGradient id="roadGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#4e4a72" />
        <stop offset="100%" stop-color="#3a3660" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1440" height="560" fill="url(#cycSky)" />

    <polygon points="0,360 240,250 480,340 760,220 1040,350 1440,260 1440,560 0,560" fill="url(#farHaze)" opacity="0.55" />

    <g class="cloud" fill="url(#cloudGrad)" opacity="0.85">
      <ellipse cx="220" cy="110" rx="70" ry="26" />
      <ellipse cx="280" cy="95" rx="55" ry="22" />
    </g>
    <g class="cloud cloud-2" fill="url(#cloudGrad)" opacity="0.75">
      <ellipse cx="1180" cy="150" rx="80" ry="28" />
      <ellipse cx="1250" cy="130" rx="50" ry="20" />
    </g>

    <g id="mtn-back">
      <polygon points="0,480 100,360 160,420 220,320 300,420 380,480" fill="url(#coolShadow)" />
      <polygon points="0,480 100,360 160,420" fill="url(#warmMid)" />
      <polygon points="160,420 220,320 300,420" fill="url(#warmLight)" />
      <polygon points="880,480 990,340 1060,410 1140,300 1230,420 1320,480" fill="url(#coolShadow)" />
      <polygon points="880,480 990,340 1060,410" fill="url(#warmMid)" />
      <polygon points="1060,410 1140,300 1230,420" fill="url(#warmLight)" />
      <polygon points="1250,480 1340,380 1440,460 1440,480" fill="url(#coolDark)" />
    </g>

    <g id="mtn-front">
      <polygon points="-40,500 90,380 160,440 230,360 320,440 410,500" fill="url(#coolDark)" />
      <polygon points="-40,500 90,380 160,440" fill="url(#warmMid)" />
      <polygon points="160,440 230,360 320,440" fill="url(#warmLight)" />
      <polygon points="700,500 830,390 900,450 980,370 1080,450 1180,500" fill="url(#coolDark)" />
      <polygon points="700,500 830,390 900,450" fill="url(#warmMid)" />
      <polygon points="900,450 980,370 1080,450" fill="url(#warmLight)" />
      <polygon points="1200,500 1310,400 1440,490 1440,500" fill="url(#coolShadow)" />
    </g>

    <rect x="0" y="490" width="1440" height="60" fill="url(#roadGrad)" />
    <rect x="0" y="490" width="1440" height="10" fill="#e8a9c2" opacity="0.7" />
    <g stroke="#f4efe4" stroke-width="4" stroke-dasharray="30 24" opacity="0.55">
      <line x1="0" y1="520" x2="1440" y2="520" />
    </g>

    <rect x="0" y="550" width="1440" height="150" fill="#413c68" />
  </svg>

  <svg class="rider rider-3" viewBox="-45 -75 105 140" aria-hidden="true" focusable="false">
    <LowPolyBike frame="#1c1a22" wheelAnim="wheel-c" />
    <LowPolyFigure
      id="rider3"
      x={0}
      y={0}
      scale={1}
      top="#2f6b4f"
      topShade="#204a37"
      helmet="#1c1a22"
      motionClass="fig-pedal-c"
      armFrontAngle={-65}
      forearmFrontAngle={-15}
      armBackAngle={-60}
      forearmBackAngle={-10}
    />
  </svg>

  <svg class="rider rider-2" viewBox="-45 -75 105 140" aria-hidden="true" focusable="false">
    <LowPolyBike frame="#1c1a22" wheelAnim="wheel-b" />
    <LowPolyFigure
      id="rider2"
      x={0}
      y={0}
      scale={1}
      top="#3a8fd9"
      topShade="#2a6ba8"
      helmet="#1c1a22"
      motionClass="fig-pedal-b"
      armFrontAngle={-65}
      forearmFrontAngle={-15}
      armBackAngle={-60}
      forearmBackAngle={-10}
    />
  </svg>

  <div class="rider-pos-1">
    <svg class="rider rider-1" viewBox="-45 -75 105 140" aria-hidden="true" focusable="false">
      <LowPolyBike frame="#1c1a22" wheelAnim="wheel-a" />
      <LowPolyFigure
        id="rider1"
        x={0}
        y={0}
        scale={1}
        top="#d97a4d"
        topShade="#b85f37"
        helmet="#e0a83a"
        motionClass="fig-pedal-a"
        armFrontAngle={-65}
        forearmFrontAngle={-15}
        armBackAngle={-60}
        forearmBackAngle={-10}
      />
    </svg>
    <div class="streaks" id="streaks"></div>
  </div>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style>
  .cycling-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .cycling-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cloud { animation: drift 50s linear infinite; }
    .cloud-2 { animation-duration: 65s; animation-delay: -20s; }
  }

  @keyframes drift {
    0% { transform: translateX(0); }
    50% { transform: translateX(-60px); }
    100% { transform: translateX(0); }
  }

  .rider {
    position: absolute;
    width: 220px;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 8px 6px rgba(20, 15, 40, 0.25));
  }

  .rider-3 {
    left: 48%;
    top: 62%;
    width: 150px;
    transform: scaleX(-1);
  }

  .rider-2 {
    left: 60%;
    top: 59%;
    width: 180px;
    transform: scaleX(-1);
  }

  .rider-pos-1 {
    position: absolute;
    left: 76%;
    top: 56%;
  }

  .rider-1 {
    position: static;
    width: 230px;
    transform: scaleX(-1);
  }

  .streaks {
    position: absolute;
    left: -60px;
    top: 30%;
    width: 60px;
    height: 4px;
    opacity: 0;
  }

  .streaks::before,
  .streaks::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: #ffffff;
  }

  .streaks::before {
    top: -10px;
  }

  .streaks::after {
    top: 12px;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.94);
    border-radius: 28px;
    box-shadow: 0 20px 60px -20px rgba(20, 20, 30, 0.35);
    padding: 3rem 3rem 3rem 2.5rem;
    max-width: 620px;
    margin-inline: 1rem;
  }

  /* --- pedalage : jambes riggees avec pivots hanche/genou reels (IK),
     roues qui tournent en continu --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.wheel) {
      animation: spin-wheel 0.6s linear infinite;
    }
    :global(.wheel-b) { animation-delay: -0.15s; }
    :global(.wheel-c) { animation-delay: -0.3s; }

    :global(.fig-pedal-a .fig-thigh-front-pivot),
    :global(.fig-pedal-b .fig-thigh-front-pivot),
    :global(.fig-pedal-c .fig-thigh-front-pivot) {
      transform-origin: 0px 0px;
      animation: thigh-front 1.05s linear infinite;
    }
    :global(.fig-pedal-a .fig-shin-front-pivot),
    :global(.fig-pedal-b .fig-shin-front-pivot),
    :global(.fig-pedal-c .fig-shin-front-pivot) {
      transform-origin: 0px 0px;
      animation: shin-front 1.05s linear infinite;
    }
    :global(.fig-pedal-a .fig-thigh-back-pivot),
    :global(.fig-pedal-b .fig-thigh-back-pivot),
    :global(.fig-pedal-c .fig-thigh-back-pivot) {
      transform-origin: 0px 0px;
      animation: thigh-back 1.05s linear infinite;
    }
    :global(.fig-pedal-a .fig-shin-back-pivot),
    :global(.fig-pedal-b .fig-shin-back-pivot),
    :global(.fig-pedal-c .fig-shin-back-pivot) {
      transform-origin: 0px 0px;
      animation: shin-back 1.05s linear infinite;
    }

    :global(.fig-pedal-b .fig-thigh-front-pivot),
    :global(.fig-pedal-b .fig-shin-front-pivot),
    :global(.fig-pedal-b .fig-thigh-back-pivot),
    :global(.fig-pedal-b .fig-shin-back-pivot) {
      animation-delay: -0.15s;
    }
    :global(.fig-pedal-c .fig-thigh-front-pivot),
    :global(.fig-pedal-c .fig-shin-front-pivot),
    :global(.fig-pedal-c .fig-thigh-back-pivot),
    :global(.fig-pedal-c .fig-shin-back-pivot) {
      animation-delay: -0.3s;
    }
  }

  @keyframes spin-wheel {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes thigh-front {
    0% { transform: rotate(-28.7deg); }
    12.5% { transform: rotate(-32.9deg); }
    25% { transform: rotate(-44.6deg); }
    37.5% { transform: rotate(-63.4deg); }
    50% { transform: rotate(-82.9deg); }
    62.5% { transform: rotate(-83deg); }
    75% { transform: rotate(-65.3deg); }
    87.5% { transform: rotate(-42deg); }
    100% { transform: rotate(-28.7deg); }
  }
  @keyframes shin-front {
    0% { transform: rotate(32.1deg); }
    12.5% { transform: rotate(57.6deg); }
    25% { transform: rotate(87.9deg); }
    37.5% { transform: rotate(111.2deg); }
    50% { transform: rotate(115deg); }
    62.5% { transform: rotate(96.4deg); }
    75% { transform: rotate(67.1deg); }
    87.5% { transform: rotate(38.2deg); }
    100% { transform: rotate(32.1deg); }
  }
  @keyframes thigh-back {
    0% { transform: rotate(-82.9deg); }
    12.5% { transform: rotate(-83deg); }
    25% { transform: rotate(-65.3deg); }
    37.5% { transform: rotate(-42deg); }
    50% { transform: rotate(-28.7deg); }
    62.5% { transform: rotate(-32.9deg); }
    75% { transform: rotate(-44.6deg); }
    87.5% { transform: rotate(-63.4deg); }
    100% { transform: rotate(-82.9deg); }
  }
  @keyframes shin-back {
    0% { transform: rotate(115deg); }
    12.5% { transform: rotate(96.4deg); }
    25% { transform: rotate(67.1deg); }
    37.5% { transform: rotate(38.2deg); }
    50% { transform: rotate(32.1deg); }
    62.5% { transform: rotate(57.6deg); }
    75% { transform: rotate(87.9deg); }
    87.5% { transform: rotate(111.2deg); }
    100% { transform: rotate(115deg); }
  }

  .cycling-scene.is-attacking .rider-pos-1 {
    animation: attack 1.6s cubic-bezier(0.3, 0, 0.2, 1) forwards;
  }

  .cycling-scene.is-attacking .streaks {
    animation: streak-flash 1.6s ease-out forwards;
  }

  @keyframes attack {
    0% { left: 76%; top: 56%; transform: scale(1); }
    100% { left: 99%; top: 46%; transform: scale(1.35); }
  }

  @keyframes streak-flash {
    0%, 15% { opacity: 0; }
    25%, 70% { opacity: 0.9; }
    100% { opacity: 0; }
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 2rem 1.5rem;
    }

    .rider {
      width: 110px !important;
      opacity: 0.55;
    }

    .rider-3 { left: 6%; top: 66%; }
    .rider-2 { left: 32%; top: 63%; }
    .rider-pos-1 { left: 60%; top: 60%; }
  }
</style>

<script>
  const scene = document.getElementById('cycling-scene');

  window.addEventListener('contact:serve', () => {
    if (!scene) return;
    scene.classList.remove('is-attacking');
    void scene.getBoundingClientRect();
    scene.classList.add('is-attacking');
    window.setTimeout(() => scene.classList.remove('is-attacking'), 1700);
  });
</script>
