<style>
  .cycling-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .cycling-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.86);
    backdrop-filter: blur(6px);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
    max-width: 560px;
    margin-inline: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rider .leg-front { animation: pedal-front 1.1s linear infinite; transform-origin: 64px 70px; }
    .rider .leg-back { animation: pedal-back 1.1s linear infinite; transform-origin: 64px 70px; }
    #rider-2 .leg-front, #rider-2 .leg-back { animation-delay: -0.3s; }
    #rider-1 .leg-front, #rider-1 .leg-back { animation-delay: -0.6s; }
    .rider { animation: bob 0.55s ease-in-out infinite; }
    #rider-2 { animation-delay: -0.2s; }
    #rider-1 { animation-delay: -0.4s; }
  }

  @keyframes pedal-front {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes pedal-back {
    0% { transform: rotate(180deg); }
    100% { transform: rotate(540deg); }
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }

  .rider-pos-1 {
    transform: translate(980px, 490px) scale(1.05);
  }

  .cycling-scene.is-attacking .rider-pos-1 {
    animation: attack 1.6s cubic-bezier(0.3, 0, 0.2, 1) forwards;
  }

  .cycling-scene.is-attacking #streaks {
    animation: streak-flash 1.6s ease-out forwards;
  }

  @keyframes attack {
    0% { transform: translate(980px, 490px) scale(1.05); }
    100% { transform: translate(1520px, 430px) scale(1.4); }
  }

  @keyframes streak-flash {
    0%, 15% { opacity: 0; }
    25%, 70% { opacity: 0.9; }
    100% { opacity: 0; }
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 1.75rem;
      margin-inline: 1rem;
    }
  }
</style>

<script>
  const scene = document.getElementById('cycling-scene');

  window.addEventListener('contact:serve', () => {
    if (!scene) return;
    scene.classList.remove('is-attacking');
    void scene.getBoundingClientRect();
    scene.classList.add('is-attacking');
    window.setTimeout(() => scene.classList.remove('is-attacking'), 1700);
  });
</script>
