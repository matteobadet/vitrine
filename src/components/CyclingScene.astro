<div class="cycling-scene" id="cycling-scene">
  <svg
    class="cycling-svg"
    viewBox="0 0 1440 700"
    preserveAspectRatio="xMidYMax slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="cycSky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#bcd4f2" />
        <stop offset="100%" stop-color="#eef4f7" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1440" height="560" fill="url(#cycSky)" />

    <g fill="#ffffff" opacity="0.75">
      <ellipse cx="220" cy="110" rx="70" ry="26" />
      <ellipse cx="280" cy="95" rx="55" ry="22" />
      <ellipse cx="1180" cy="150" rx="80" ry="28" />
      <ellipse cx="1250" cy="130" rx="50" ry="20" />
    </g>

    <g id="mtn-back" fill="#a9b8e0" opacity="0.55">
      <polygon points="0,480 120,340 220,480" />
      <polygon points="150,480 260,300 380,480" />
      <polygon points="330,480 460,360 580,480" />
      <polygon points="900,480 1030,330 1160,480" />
      <polygon points="1080,480 1220,350 1360,480" />
      <polygon points="1280,480 1400,370 1440,480" />
    </g>

    <g id="mtn-front" fill="#7c8fd4" opacity="0.6">
      <polygon points="-40,500 90,380 210,500" />
      <polygon points="180,500 330,370 470,500" />
      <polygon points="420,500 540,410 660,500" />
      <polygon points="820,500 950,390 1090,500" />
      <polygon points="1040,500 1190,380 1340,500" />
      <polygon points="1300,500 1440,400 1440,500" />
    </g>

    <rect x="0" y="490" width="1440" height="60" fill="#3a3660" />
    <rect x="0" y="490" width="1440" height="10" fill="#e8a9c2" opacity="0.7" />
    <g stroke="#f4efe4" stroke-width="4" stroke-dasharray="30 24" opacity="0.55">
      <line x1="0" y1="520" x2="1440" y2="520" />
    </g>

    <rect x="0" y="550" width="1440" height="150" fill="#4a4570" />
  </svg>

  <img src="/illustrations/cycling.svg" alt="" aria-hidden="true" class="rider rider-3" />
  <img src="/illustrations/cycling.svg" alt="" aria-hidden="true" class="rider rider-2" />
  <div class="rider-pos-1">
    <img src="/illustrations/cycling.svg" alt="" aria-hidden="true" class="rider rider-1" />
    <div class="streaks" id="streaks"></div>
  </div>

  <div class="hero-panel reveal">
    <slot />
  </div>
</div>

<style>
  .cycling-scene {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .cycling-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .rider {
    position: absolute;
    width: 220px;
    height: auto;
    filter: drop-shadow(0 8px 6px rgba(20, 15, 40, 0.25));
  }

  .rider-3 {
    left: 4%;
    top: 60%;
    width: 170px;
    transform: scaleX(-1);
  }

  .rider-2 {
    left: 33%;
    top: 57%;
    width: 195px;
    transform: scaleX(-1);
  }

  .rider-pos-1 {
    position: absolute;
    left: 60%;
    top: 58%;
  }

  .rider-1 {
    position: static;
    width: 230px;
    transform: scaleX(-1);
  }

  .streaks {
    position: absolute;
    left: -60px;
    top: 30%;
    width: 60px;
    height: 4px;
    opacity: 0;
  }

  .streaks::before,
  .streaks::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: #ffffff;
  }

  .streaks::before {
    top: -10px;
  }

  .streaks::after {
    top: 12px;
  }

  .hero-panel {
    position: relative;
    z-index: 1;
    background: rgba(255, 252, 244, 0.86);
    backdrop-filter: blur(6px);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
    max-width: 560px;
    margin-inline: 1.5rem;
    box-shadow: var(--shadow-soft);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rider { animation: bob 0.6s ease-in-out infinite; }
    .rider-2 { animation-delay: -0.2s; }
    .rider-1 { animation-delay: -0.4s; }
  }

  @keyframes bob {
    0%, 100% { transform: scaleX(-1) translateY(0); }
    50% { transform: scaleX(-1) translateY(-4px); }
  }

  .cycling-scene.is-attacking .rider-pos-1 {
    animation: attack 1.6s cubic-bezier(0.3, 0, 0.2, 1) forwards;
  }

  .cycling-scene.is-attacking .streaks {
    animation: streak-flash 1.6s ease-out forwards;
  }

  @keyframes attack {
    0% { left: 60%; top: 58%; transform: scale(1); }
    100% { left: 98%; top: 48%; transform: scale(1.35); }
  }

  @keyframes streak-flash {
    0%, 15% { opacity: 0; }
    25%, 70% { opacity: 0.9; }
    100% { opacity: 0; }
  }

  @media (max-width: 720px) {
    .hero-panel {
      padding: 1.75rem;
      margin-inline: 1rem;
    }

    .rider {
      width: 130px !important;
    }
  }
</style>

<script>
  const scene = document.getElementById('cycling-scene');

  window.addEventListener('contact:serve', () => {
    if (!scene) return;
    scene.classList.remove('is-attacking');
    void scene.getBoundingClientRect();
    scene.classList.add('is-attacking');
    window.setTimeout(() => scene.classList.remove('is-attacking'), 1700);
  });
</script>
