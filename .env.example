# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui recevra les messages du formulaire de contact
CONTACT_EMAIL_TO=contact@mbadet.fr

# Adresse d'expédition — doit appartenir à un domaine vérifié dans Resend
# (ex: "mbadet.fr" vérifié via ses enregistrements DNS)
CONTACT_EMAIL_FROM=Contact mbadet.fr <contact@mbadet.fr>

# Port d'écoute du serveur Node (adapter Astro standalone)
PORT=4321
HOST=0.0.0.0
